	"version": "2.0.0",
	"tasks": [
        {
            "label": "openStoryHtml",
            "command": "firefox",
            "windows": {
                "command": "C:/Program Files/Mozilla Firefox/firefox.exe"
            },
            "args": ["C:/Users/arudy/OneDrive/Live-Another-Life/LAL.html"],
            "dependsOrder": "sequence",
            "dependsOn": ["delOldStory", "buildStoryHtml"]
        },
		{
			"label": "buildStoryHtml",
			"type": "shell",
			"presentation": {
				"echo": false,
				"reveal": "never",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"close": true
			},
			"group": "build",
			"command": "C:/users/arudy/OneDrive/tweego-2.1.1-windows-x64/tweego.exe -f sugarcube-2 -o LAL.html ./src",
            "dependsOn": ["delOldStory"]	
		},
        {
            "label": "delOldStory",
            "type": "shell",
			"presentation": {
				"echo": false,
				"reveal": "never",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"close": true
			},
            "command": "del LAL.html",
        },
		{
			"label": "autoTweego",
			"type": "shell",
			"command" : "C:/users/arudy/OneDrive/tweego-2.1.1-windows-x64/tweego.exe -w src -o LAL.html"
		}
	]       
}