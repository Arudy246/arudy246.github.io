/* targetCost:     <<numberbox '$targetCost' $targetCost>>
typeCost:       <<numberbox '$typeCost' $typeCost>>
durationCost:   <<numberbox '$durationCost' $durationCost>>
effectCost:     <<numberbox '$effectCost' $effectCost>>
strCost:        <<numberbox '$strCost' $strCost>>
discLvl:        <<numberbox '$discLvl' $discLvl>>

Equation Result: <<print $eqResult.toFixed(2)>>

<<button [[Process Cost Equation | Testing_Spells]]>>
    <<set $eqResult = $targetCost * $typeCost * $durationCost * $strCost * ($effectCost / ($discLvl * 0.4))>>
<</button>>
