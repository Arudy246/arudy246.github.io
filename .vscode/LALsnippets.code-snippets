{
	// Place your Live-Another-Life workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

	"Main Dialogue Wrapper": {
		"prefix": "dlg",
		"body": [
			"<<dlg '${1:label}' ${2:levelstart}>>",
			"	$0",
			"<</dlg>>"
		],
		"description": "The main stepped dialogue wrapper, contains the levels."
	},
	"Dialogue Level": {
		"prefix": "level",
		"body": [
			"<<level ${1:level}>>",
			"	$0",
			"<</level>>"
		],
		"description": "The level of the dialogue, contains the lines."
	},
	"Dialogue Line": {
		"prefix": "line",
		"body": [
			"<<line '${1:Short Comment}' ${2:levellink(optional)}>>",
			"	$0",
			"<</line>>"
		],
		"description": "The line of the dialogue, will likely contain <<speech>> elements."
	},
	"Speech Boxes": {
		"prefix": "speech",
		"body": [
			"<<speech ${1:name}>>",
			"	$2",
			"<</speech>>$0"
		]
	},
	"Npc Available": {
		"prefix": "npcavailable",
		"body": [
			"<<NpcAvailable ${1:Starttime} ${2:Endtime} ${3:Npcname} ${4:Dayname_opt} ${5:Eventname_opt} ${6:random_opt}>>"
		],
		"description": "Allows npc to be available according to time/day args and allow random convos after event completed."
	}
}