    <<set $npcPersonalityList = {
        friendly: {
            desc: "friendly disposition",
            placeholderA: 0,
            placeholderB: 0,
            greetings: [
                "Oh, hi!",
                "Well hello there!",
                "Gosh its good to see you!",
                "What a pleasant suprise!"
            ]
        },
        neutral: {
            desc: "polite disposition",
            placeholderA: 0,
            placeholderB: 0,
            greetings: [
                "Hello.",
                "Hi.",
                "Good day.",
                "What can I do for you?"
            ]
        },
        unfriendly: {
            desc: "unfriendly attitude",
            placeholderA: 0,
            placeholderB: 0,
            greetings: [
                "Yes?",
                "What?",
                "I'm busy, what do you want?",
                "Now what?"
            ]
        }
    }>>

