:: StoryInit
    <<set $dateTime = {
        hour: 20,
        min: 30,
        day: 7,
        month: 1,
        date: 8,
        year: 2023,
        dayName: "",
        monthName: ""
    }>>

    /*-----Player Stats and Info-----*/
    /*---the dynamic body stats are able to change and the description of the player will change based on a range.---*/
    /*-weight is on a range of 1-100, 1-15 is skinny, 16-30 is fit, 30-70 is average, 70-86 is husky, 86-100 is fat-*/
    /*-hair length is on a range of 1-7, 1 bald or shaved, 2 is ear length, 3 is neck length, 4 is shoulder length, 5 is chest length, 6 is waist, 7 is knees-*/
    /*-atttractiveness is gauged on a combination of height, face shape, hair length, and heavily by weight (equation is different between sexes)*/
    /*XXXXX Add beard stats XXXXX*/

