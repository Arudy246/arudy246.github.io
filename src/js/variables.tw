    <<set $critters = {
        rabidDog: {
            img: '',
            name: {
                firstName: 'Rabid Dog'
            },
            description: 'It\'s mangy, covered in fleas, and you can see it drooling all over itself. Not a pretty sight.',
            stats: {
                life: {
                    max: 5,
                    cur: 5,
                    pre: 5
                },
                stamina: {
                    max: 3,
                    cur: 3,
                    pre: 3
                },
                attack: 2,
                defense: 0,
            }
        },
        aggressiveSquirrel: {
            img: function() {
                let Container = document
                let element = $(Container).find('#enemyAvatar')
                element.attr('style', 'background-image: url("img/aggressivesquirrel.jpg")')
            },
            name: {
                firstName: 'Oddly Aggressive Squirrel'
            },
            description: 'Seriously, it\'s a bunny. It\'s just sort of an aggressive looking...bunny. This cannot be happening.',
            stats: {
                life: {
                    max: 2,
                    cur: 2,
                    pre: 2
                },
                stamina: {
                    max: 1,
                    cur: 1,
                    pre: 1
                },
                attack: 1,
                defense: 0,
            }
        },
        tinyImp : {
            img: function() {
                let Container = document
                let element = $(Container).find('#enemyAvatar')
                element.attr('style', 'background-image: url("img/greenimp.png")')
            },
            name: {
                firstName: 'Tiny Green Imp'
            },
            description: 'It\'s small, green, and seems to think it\'s more fearsome than it really is.',
            stats: {
                life: {
                    max: 3,
                    cur: 3,
                    pre: 3
                },
                stamina: {
