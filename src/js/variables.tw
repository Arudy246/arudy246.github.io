    <<set $npcPersonalityList = {
        friendly: {
            desc: "friendly disposition",
            placeholderA: 0,
            placeholderB: 0,
            greetings: [
                "Oh, hi!",
                "Well hello there!",
                "Gosh its good to see you!",
