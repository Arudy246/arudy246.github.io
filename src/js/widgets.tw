:: Widgets[widget]

    /*  <<passagehead args0:locations args:1residence_starr_bathroom ?args2:noclass>>
            <<speech>><</speech>>
        <</passagehead>>
    */
    <<nobr>>
        <<widget "passagehead" container>>
            <<set _scene = 'img/' + _args[0] + '/' +_args[1] + '.jpg'>>
            <<print '<div id="passage-scene">' + '<img class="scene" src=' + _scene + '>' + '</div>'>>
            <div class='w3-panel w3-border w3-border w3-border-teal w3-round-large w3-padding' style='background-color:#1a0000'>
                <<if $systemVar.logs == true>>
                    <i class='w3-text-blue'>
                        <<print 'PASSAGE: ' + passage() + ' ||| TAGS: ' + tags()>>
                    </i>
                <</if>>
                <<if _args[2] == 'noclass'>>
                    <<Updates noclass>>
                <<else>>
                    <<Updates>>
                <</if>>
                <<printRelGain>>
            </div>
            <div id='passage-desc'>
                _contents
            </div>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "passagestart">>
            <div class='w3-panel w3-border w3-border w3-border-teal w3-round-large w3-padding' style='background-color:#1a0000'>
                <<if $systemVar.logs == true>>
                    <i class='w3-text-blue'>
                        <<print 'PASSAGE: ' + passage()>>
                    </i>
                <</if>>
                <<if _args[0] == 'noclass'>>
                    <<Updates noclass>>
                <<else>>
                    <<Updates>>
                <</if>>
                <<printRelGain>>
            </div>
        <</widget>>
    <</nobr>>

    /* relGain amy 10 (int | sus)*/
    <<nobr>>
        <<widget "relGain">>
            <<if _args[1] > 0 && !_args[2]>>
                <<set $plr.relations[_args[0]].positive += _args[1] + ($plr.body.dynamic.atttractiveness / 10)>>

            <<elseif _args[1] < 0 && !_args[2]>>
                <<set $plr.relations[_args[0]].negative += _args[1] + ($plr.body.dynamic.atttractiveness / 10)>>

            <<elseif _args[2]>>
                <<set $tempVar.relType = _args[2]>>
                <<if _args[2] == 'int'>>
                    <<set $plr.relations[_args[0]].intimate += _args[1] + ($plr.body.dynamic.atttractiveness / 10)>>

                <<elseif _args[2] == 'sus'>>
                    <<set $plr.relations[_args[0]].suspicion += _args[1]>>
                <</if>>
            <</if>>

            <<set $tempVar.relNPC = _args[0]>>
            <<set $tempVar.relAmt = _args[1]>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "printRelGain">>
            <<if $tempVar.relAmt>>
                <<if $tempVar.relAmt > 0 && !$tempVar.relType>>
                    <<print '<span class="green">Your relationship with ' +  $npcs[$tempVar.relNPC].name.firstName + ' ' + $npcs[$tempVar.relNPC].name.lastName + ' has improved!</span>'>>

                <<elseif $tempVar.relAmt < 0 && !$tempVar.relType>>
                    <<print '<span class="w3-text-red">Your relationship with ' + $npcs[$tempVar.relNPC].name.firstName + ' ' + $npcs[$tempVar.relNPC].name.lastName + ' has deteriorated.</span>'>>

                <<elseif $tempVar.relType == 'int'>>
                    <<print '<span class="w3-text-purple">' + $npcs[$tempVar.relNPC].name.firstName + ' ' + $npcs[$tempVar.relNPC].name.lastName + ' is now more interested in you...</span>'>>

                <<elseif $tempVar.relType == 'sus'>>
                    <<print '<span class="w3-text-red">' + $npcs[$tempVar.relNPC].name.firstName + ' ' + $npcs[$tempVar.relNPC].name.lastName + ' is now more suspicious of you.</span>'>>
                <</if>>
                <<set $tempVar.relAmt = 0>>
                <<set $tempVar.relType = 0>>
                <<set $tempVar.relNPC = 0>>
            <</if>>
        <</widget>>
    <</nobr>>

    <<widget "calcAttractiveness">>
        <<nobr>>
            <<set $plr.body.dynamic.atttractiveness = 0>>
            <<if $plr.body.static.sex == "male" && ($plr.body.static.height == "tall" || $plr.body.static.height == "very tall")>>
                <<set $plr.body.dynamic.atttractiveness += 10>>
            <<elseif $plr.body.static.sex == "female" && ($plr.body.static.height == "average" || $plr.body.static.height == "short")>>
                <<set $plr.body.dynamic.atttractiveness += 10>>
            <</if>>

            <<if $plr.body.static.faceShape == "oblong" || $plr.body.static.faceShape == "square">>
                <<set $plr.body.dynamic.atttractiveness += 10>>
            <</if>>

            <<if $plr.body.dynamic.weight >= 20 && $plr.body.dynamic.weight <= 55>>
                <<set $plr.body.dynamic.atttractiveness += 10>>
            <</if>>

            <<if $plr.body.static.sex == "female">>
                <<set $plr.body.dynamic.atttractiveness *= 1.1>>
        <</if>>
        <</nobr>>
    <</widget>>

    /* calcTime 20(increase in minutes) 5(random extra minutes) (empty if stam drain or false if no stam drain*/
    <<nobr>>
        <<widget "calcTime">>
            <<set _minComp = $dateTime.min>>
                <<if _args[1]>>
                    <<set $dateTime.min += _args[0] + random(_args[1])>>
                    <<set $dateTime.minPassed = $dateTime.min - _minComp>>

                    <<if _args[2] != false>>
                        <<set _staminaLoss = $dateTime.minPassed * 0.01>>
                    <</if>>

                    <<elseif _args[0]>>
                        <<set $dateTime.min += _args[0]>>
                        <<set $dateTime.minPassed = $dateTime.min - _minComp>>

                        <<if _args[2] != false>>
                            <<set _staminaLoss = $dateTime.minPassed * 0.01>>
                        <</if>>
                <</if>>

                <<for _i = $dateTime.min; _i >= 60; _i = $dateTime.min>>
                    <<if $dateTime.min >= 60>>
                        <<set $dateTime.hour += 1>>
                        <<set $dateTime.min -= 60>>
                    <</if>>
                <</for>>
                <<if $dateTime.hour >= 24>>
                    <<set $dateTime.date += 1>>
                    <<set $dateTime.hour -= 24>>
                    <<set $dateTime.day += 1>>
                <</if>>
                <<if $dateTime.day > 7 >>
                    <<set $dateTime.day = 1>>
                <</if>>
                <<if $dateTime.date > 30>>
                    <<set $dateTime.month += 1>>
                    <<set $dateTime.date -= 30>>
                <</if>>
                <<if $dateTime.month > 12 >>
                    <<set $dateTime.year += 1>>
                    <<set $dateTime.month = 1>>
                <</if>>

                <<replace "#timeplusdate">>
                    <<if $dateTime.day == 1>>
                        <<set $dateTime.dayName = "Monday">>
                    <</if>>
                    <<if $dateTime.day == 2>>
                        <<set $dateTime.dayName = "Tuesday">>
                    <</if>>
                    <<if $dateTime.day == 3>>
                        <<set $dateTime.dayName = "Wednesday">>
                    <</if>>
                    <<if $dateTime.day == 4>>
                        <<set $dateTime.dayName = "Thursday">>
                    <</if>>
                    <<if $dateTime.day == 5>>
                        <<set $dateTime.dayName = "Friday">>
                    <</if>>
                    <<if $dateTime.day == 6>>
                        <<set $dateTime.dayName = "Saturday">>
                    <</if>>
                    <<if $dateTime.day == 7>>
                        <<set $dateTime.dayName = "Sunday">>
                    <</if>>
                    <<if $dateTime.month == 1>>
                        <<set $dateTime.monthName = "January">>
                    <</if>>
                    <<if $dateTime.month == 2>>
                        <<set $dateTime.monthName = "February">>
                    <</if>>
                    <<if $dateTime.month == 3>>
                        <<set $dateTime.monthName = "March">>
                    <</if>>
                    <<if $dateTime.month == 4>>
                        <<set $dateTime.monthName = "April">>
                    <</if>>
                    <<if $dateTime.month == 5>>
                        <<set $dateTime.monthName = "May">>
                    <</if>>
                    <<if $dateTime.month == 6>>
                        <<set $dateTime.monthName = "June">>
                    <</if>>
                    <<if $dateTime.month == 7>>
                        <<set $dateTime.monthName = "July">>
                    <</if>>
                    <<if $dateTime.month == 8>>
                        <<set $dateTime.monthName = "August">>
                    <</if>>
                    <<if $dateTime.month == 9>>
                        <<set $dateTime.monthName = "September">>
                    <</if>>
                    <<if $dateTime.month == 10>>
                        <<set $dateTime.monthName = "October">>
                    <</if>>
                    <<if $dateTime.month == 11>>
                        <<set $dateTime.monthName = "November">>
                    <</if>>
                    <<if $dateTime.month == 12>>
                        <<set $dateTime.monthName = "December">>
                    <</if>>
                    <<if $dateTime.hour <= 9 && $dateTime.min <= 9>>
                        <<print '<br>0' + $dateTime.hour + ':0' + $dateTime.min + '<br>'>>
                    <<elseif $dateTime.hour <= 9>>
                        <<print '<br>0' + $dateTime.hour + ':' + $dateTime.min + '<br>'>>
                    <<elseif $dateTime.min <= 9>>
                        <<print '<br>' + $dateTime.hour + ':0' + $dateTime.min + '<br>'>>
                    <<else>>
                        <<print '<br>' + $dateTime.hour + ':' + $dateTime.min + '<br>'>>
                    <</if>>

                    <<print $dateTime.dayName + ' ' + $dateTime.monthName + ' ' + $dateTime.date + ', ' + $dateTime.year + '<br>'>>
                <</replace>>

                <<if _staminaLoss>>
                    <<set _staminaLoss = _staminaLoss * -1>>
                    <<setStats 'plr' 'stamina' _staminaLoss>>
                <</if>>

                <<if $systemVar.timecheck == true>>
                    <<consolelog '---calcTime Start---'>>
                    <<consolelog 'Hour' $dateTime.hour>>
                    <<consolelog 'Minute' $dateTime.min>>
                    <<consolelog 'Day' $dateTime.day>>
                    <<consolelog 'Dayname' $dateTime.dayName>>
                    <<consolelog 'Month' $dateTime.month>>
                    <<consolelog 'Year' $dateTime.year>>
                    <<consolelog 'minPassed' $dateTime.minPassed>>
                    <<consolelog 'staminaLoss' _staminaLoss>>
                    <<consolelog '-----calcTime End-----'>>
                <</if>>

                <<run Stamina()>>
                <<processClean>>
                <<set $dateTime.minPassed = 0>>
                <<unset _staminaLoss>>
        <</widget>>
    <</nobr>>

    /* readBook itemtype (miscbook, skillbook, spellbook, recipebook, lorebook, discbook) itemID */
    <<nobr>>
        <<widget "readBook">>
            <<switch _args[0]>>
                <<case "miscbook">>
                    <<if $unlockVar.userInterface.locations != true>>
                        <<set $unlockVar.userInterface.locations = true>>
                    <</if>>

                    <<if $bookMisc[_args[1]].pagesRead != $bookMisc[_args[1]].pagesTotal>>
                        <<goto "Event_Unlock_Location">>
                        <<set _address = $bookMisc[_args[1]]>>

                        <<set _address.pagesRead += 1>>

                        <<pickup $plrinvbooks _args[1] 1>>
                        <<calcTime 30 15>>

                        <<set _unlocknum =_address.pagesRead>>
                        <<set _unlockFunc = _address.pageUnlocks[_unlocknum]()>>
                        <<set _unlockmessage = _unlockFunc>>

                        <<set $eventVar.location.name = _unlockmessage>>
                        <<set $eventVar.location.book = _address.title>>
                        <<set $eventVar.location.pagesCur = _address.pagesRead>>
                        <<set $eventVar.location.pagesMax = _address.pagesTotal>>
                        
                        <<run Dialog.close()>>

                        <<if _address.pagesRead == _address.pagesTotal>>
                            <<drop $plrinvbooks _args[1] 1>>
                            <<run
                                Dialog.setup("Chapter Read and Book Finished");
                                Dialog.wiki("After reading chapter " + _unlocknum + "/" + $bookMisc[_args[1]].pagesTotal + " of " + "'" + $bookMisc[_args[1]].title + "'" + " you discovered " + _unlockmessage + ".");
                                Dialog.append("<br><br><br>You finished the book, there is nothing left to learn from this. The book disintegrates from your hands.");
                                Dialog.open();
                            >>    
                        <</if>>
                    <</if>>

                <<case "skillbook">>

                <<case 'discbook'>>
                    <<set _address = $discbook>>

                    <<if _address.pagesRead != _address.pagesTotal && $plr.stats.sanity.cur >= _address.costMult>>
                        <<set _address.pagesRead += 1>>
                        <<pickup $plrinvbooks _args[1] 1>>
                        <<set $plr.stats.sanity.cur -= _address.costMult>>
                        <<set $plr.stats.sanity.max += (_address.costMult / 10)>>
                        <<calcTime 60 30>>

                        <<set _discipline = _address.discipline>>
                        <<set _gainLvl = _address.gainLvl>>
                        <<set _plrDiscipline = $plr.disciplines[_discipline]>>

                        <<if _plrDiscipline.level > 1>>
                            <<set _plrDiscipline.level += _gainLvl>>
                        <<else>>
                            <<set _plrDiscipline.level += (_gainLvl / _plrDiscipline.level)>>
                        <</if>>

                        <<run
                            Dialog.setup("Magical Discipline Book Read");
                            Dialog.wiki("After reading chapter " + _address.pagesRead + "/" + _address.pagesTotal + " of " + "'" + _address.title + "'" + " you learned more about the " + _discipline + ' discipline.');
                            Dialog.open();
                        >>
                        <<run Sanity()>>

                        <<elseif $plr.stats.sanity.cur < _address.costMult>>
                        <<run UI.alert('I feel my mental stability waning, I can\'t possibly read anything else right now.')>>
                        <<pickup $plrinvbooks _args[1] 1>>
                    <</if>>

                <<case "spellbook">>
                    <<if $unlockVar.userInterface.spells == false>>
                        <<set $unlockVar.userInterface.spells = true>>
                    <</if>>

                    <<if $unlockVar.events.firstSpellLearned == false>>
                        <<set $unlockVar.events.firstSpellLearned = true>>
                    <</if>>

                    <<set _address = $bookSpell[_args[1]]>>
                    <<if _address.pagesRead != _address.pagesTotal && $plr.stats.sanity.cur >= _address.costMult>>
                        <<set $plr.stats.sanity.cur -= _address.costMult>>
                        <<set $plr.stats.sanity.max += (_address.costMult / 10)>>
                        <<goto "Event_Unlock_Spell">>

                        <<set _address.pagesRead += 1>>

                        <<pickup $plrinvbooks _args[1] 1>>

                        <<calcTime 60 30>>

                        <<set _unlocknum = _address.pagesRead>>
                        <<set _unlockFunc = _address.pageUnlocks[_unlocknum]()>>
                        <<set _unlockmessage ="how to use the " + _unlockFunc.latin  + " spell word!">>

                        <<set $eventVar.spell.name = _unlockFunc.latin>>
                        <<set $eventVar.spell.book = _address.title>>
                        <<set $eventVar.spell.description = _unlockFunc.description>>
                        <<set $eventVar.spell.pagesCur = _address.pagesRead>>
                        <<set $eventVar.spell.pagesMax = _address.pagesTotal>>

                        /* <<run
                            Dialog.setup("Spell Tome Studied");
                            Dialog.wiki("After reading chapter " + _unlocknum + "/" + _address.pagesTotal + " of " + "'" + _address.title + "'" + " you learned " + _unlockmessage);
                            Dialog.open();
                        >> */
                        <<run Dialog.close()>>
                        <<run Sanity()>>

                    <<elseif _address.pagesRead == _address.pagesTotal>>
                        <<run UI.alert("I have already learned all I can from this tome.")>>

                    <<elseif $plr.stats.sanity.cur < _address.costMult>>
                        <<run UI.alert('I feel my mental stability waning, I can\'t possibly read anything else right now.')>>
                        <<pickup $plrinvbooks _args[1] 1>>

                    <</if>>

                <<case "recipebook">>

                <<case "lorebook">>

            <</switch>>
        <</widget>>
    <</nobr>>

    /* foundItem itemtype(miscbook, skillbook, material, misc, spellbook) itemID*/
    <<nobr>>
        <<widget "foundItem">>
            <<switch _args[0]>>
                <<case "bookmisc">>
                    <<run 
                        Dialog.setup("Book Found");
                        Dialog.wiki("You found a book titled '<b>" + $bookMisc[_args[1]].title + "</b>.'" + "<br><br>" + " The first page reads '<i>" + $bookMisc[_args[1]].description + "</i>'.");
                        Dialog.open();
                    >>
                    <<pickup $plrinvbooks _args[1] 1>>

                <<case "material">>
                    <<set _address = $itemMaterial._args[1]>>
                    <<run 
                        Dialog.setup("Material Found");
                        Dialog.wiki("You found some " + _address.title + ".");
                        Dialog.open();
                    >>
                    <<pickup $plrinvmaterials _args[1] 1>>

                <<case "misc">>
                    <<set _address = $itemMisc._args[1]>>
                    <<run 
                        Dialog.setup("Item Found");
                        Dialog.wiki("You found a " + _address.title + ".");
                        Dialog.open();
                    >>
                    <<pickup $plrinvmisc _args[1] 1>>

                <<case "bookspell">>
                    <<run 
                        Dialog.setup("Spell Tome Found");
                        Dialog.wiki("You found a tome titled '<b>" + $bookSpell[_args[1]].title + "</b>.'" + "<br><br>" + " The first page reads '<i>" + $bookSpell[_args[1]].description + "</i>'.");
                        Dialog.open();
                    >>
                    <<pickup $plrinvbooks _args[1] 1>>
                <<case 'bookdisc'>>
                    <<run
                        Dialog.setup('Magical Discipline Book Found');
                        Dialog.wiki("You found a book titled '<b>" + $bookDisc[_args[1]].title + "</b>.'" + "<br><br>" + " The first page reads '<i>" + $bookSpell[_args[1]].description + "</i>'.");
                        Dialog.open();
                    >>
            <</switch>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "tone" container>>
                <<if _args[0] == "neg">>
                    <span class="negTone">
                        [_contents]
                    </span>
                <<elseif _args[0] == "pos">>
                    <span class="posTone">
                        [_contents]
                    </span>
                <</if>>
        <</widget>>
    <</nobr>>

    /* setStats (plr or npcname) (stat to change) (# to increase by or use negative #)*/
    <<nobr>>
        <<widget 'setStats'>>
            <<set _curPass = passage()>>
            <<if tags().includes('room') && $roomVars[_curPass].clean && _args[0] == 'plr' && _args[2] > 0 && (_args[1] == 'stamina' || _args[1] == 'sanity')>>
                <<set _cleanMod = $roomVars[_curPass].clean>>
                <<if _cleanMod >= 20>>
                    <<set _args[2] = _args[2] * 0.5>>

                    <<elseif _cleanMod < 20 && _cleanMod >= 10>>
                        <<set _args[2] = _args[2] * 0.8>>

                    <<elseif _cleanMod < 10 && _cleanMod >= 5>>
                        <<set _args[2] = _args[2] * 1.1>>

                    <<elseif _cleanMod < 5>>
                        <<set _args[2] = _args[2] * 1.4>>    
                <</if>>
            <</if>>

            <<if _args[0] == 'plr'>>
                <<set _targ = $plr.stats>>

            <<else>>
                <<set _targ = $npcs[_args[0]].stats>>

            <</if>>
            <<if _args[1]>>
                <<set _stat = _targ[_args[1]]>>
                <<set _stat.pre = _stat.cur>>

                <<set _stat.cur += _args[2]>>

                <<if _stat.cur > _stat.max>>
                    <<set _stat.cur = _stat.max>>
                <</if>>
                <<if _targ.stamina.cur <= 0 && _targ.stamina.max > 0>>
                    <<goto 'Out_of_Stamina'>>

                    <<elseif _targ.life.cur <= 0 && _targ.life.max > 0>>
                        <<goto 'Out_of_Life'>>
                        
                    <<elseif _targ.sanity.cur <= 0 && _targ.sanity.max > 0>>
                        <<goto 'Out_of_Sanity'>>
                <</if>>

            <</if>>
            <<run 
                Stamina();
                Life();
                FocusStat();
                Sanity();
            >>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget 'statsChange'>>
            <<if $plr.stats.stamina.pre>>
                <<set _stamDiff = ($plr.stats.stamina.cur - $plr.stats.stamina.pre)>>
                <<if _stamDiff >= 0.005 || _stamDiff <= -0.005>>
                    <<if $plr.stats.stamina.pre < $plr.stats.stamina.cur>>
                        <<print
                            '<div class="w3-text-green">I gained ' + _stamDiff.toFixed(2) + ' stamina.</div>'
                        >>
                            
                        <<elseif $plr.stats.stamina.pre > $plr.stats.stamina.cur>>
                            <<print
                                '<div class="w3-text-orange">I\'ve lost ' + (_stamDiff.toFixed(2) * -1) + ' stamina.</div>'
                            >>
                    <</if>>
                <</if>>
                <<set $plr.stats.stamina.pre = ''>>
            <</if>>

            <<if $plr.stats.life.pre>>
                <<set _lifeDiff = ($plr.stats.life.cur - $plr.stats.life.pre)>>
                <<if _lifeDiff >= 0.005 || _lifeDiff <= -0.005>>
                    <<if $plr.stats.life.pre < $plr.stats.life.cur>>
                        <<print
                            '<div class="w3-text-green">I gained ' + _lifeDiff.toFixed(2) + ' life.</div>'
                        >>
                            
                        <<elseif $plr.stats.life.pre > $plr.stats.life.cur>>
                            <<print
                                '<div class="w3-text-orange">I\'ve lost ' + (_lifeDiff.toFixed(2) * -1) + ' life.</div>'
                            >>
                    <</if>>
                <</if>>
                <<set $plr.stats.life.pre = ''>>
            <</if>>

            <<if $plr.stats.focus.pre>>
                <<set _focusDiff = ($plr.stats.focus.cur - $plr.stats.focus.pre)>>
                <<if _focusDiff >= 0.005 || _focusDiff <= -0.005>>
                    <<if $plr.stats.focus.pre < $plr.stats.focus.cur>>
                        <<print
                            '<div class="w3-text-green">I gained ' + _focusDiff.toFixed(2) + ' focus.</div>'
                        >>
                            
                        <<elseif $plr.stats.focus.pre > $plr.stats.focus.cur>>
                            <<print
                                '<div class="w3-text-orange">I\'ve lost ' + (_focusDiff.toFixed(2) * -1) + ' focus.</div>'
                            >>
                    <</if>>
                <</if>>
                <<set $plr.stats.focus.pre = ''>>
            <</if>>

            <<if $plr.stats.sanity.pre>>
                <<set _sanityDiff = ($plr.stats.sanity.cur - $plr.stats.sanity.pre)>>
                <<if _sanityDiff >= 0.005 || _sanityDiff <= -0.005>>
                    <<if $plr.stats.sanity.pre < $plr.stats.sanity.cur>>
                        <<print
                            '<div class="w3-text-green">I gained ' + _sanityDiff.toFixed(2) + ' sanity.</div>'
                        >>
                            
                        <<elseif $plr.stats.sanity.pre > $plr.stats.sanity.cur>>
                            <<print
                                '<div class="w3-text-orange">I\'ve lost ' + (_sanityDiff.toFixed(2) * -1) + ' sanity.</div>'
                            >>
                    <</if>>
                <</if>>
                <<set $plr.stats.sanity.pre = ''>>
            <</if>>
        <</widget>>
    <</nobr>>

    /* i.e. <<setDisc plr abjuration 0.3>> or <<setDisc plr random 0.2>> */
    <<nobr>>
        <<widget 'setDisc'>>
            <<if _args[1] == 'random'>>
                <<set _rando = random(1,14)>>
                <<set _discArray = [
                    'transmutation',
                    'elemental',
                    'restoration',
                    'enchantment',
                    'necromancy',
                    'lunar',
                    'illusion',
                    'divination',
                    'conjuration',
                    'biomancy',
                    'astromancy',
                    'animancy',
                    'alchemy',
                    'abjuration'
                ]>>

                <<set _disc = _discArray[_rando]>>
                <<consolelog 'setDisc Random' _disc>>

                <<else>>
                    <<set _disc = _args[1]>>
            <</if>>
            
            <<set _discAmount = _args[2]>>

            <<if _args[0] == 'plr'>>
                <<set _discTarg = $plr.disciplines>>

                <<else>>
                    <<set _discTarg = $npcs[_args[0]].disciplines>>
            <</if>>

            <<if _discTarg[_disc].pre == 0>>
                <<set _discTarg[_disc].pre = 0.0001>>
            <</if>>

            <<set _discTarg[_disc].pre = _discTarg[_disc].level - _discTarg[_disc].pre>>

            <<set _discTarg[_disc].level += _discAmount>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget 'discChange'>>
            <<for _i, _name range $plr.disciplines>>
                <<if $plr.disciplines[_i].pre != 0>>
                    <<set _discDiff = ($plr.disciplines[_i].level - $plr.disciplines[_i].pre)>>
                    <<print
                        '<div class="green">I gained ' + _discDiff.toFixed(2) + ' points in the <i>' + $plr.disciplines[_i].title + '</i> discipline.</div>'
                    >>
                    <<set $plr.disciplines[_i].pre = 0>>
                <</if>>
                <<run _i + 1>>
            <</for>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "SkillChange">>
            <<for _i, _name range $plr.skills>>
                <<for >>
                    <<if $plr.skills[_i].pre != 0>>
                        <<set _discDiff = ($plr.disciplines[_i].level - $plr.disciplines[_i].pre)>>
                        <<print
                            '<div class="green">I gained ' + _discDiff.toFixed(2) + ' points in the <i>' + $plr.disciplines[_i].title + '</i> discipline.</div>'
                        >>
                        <<set $plr.disciplines[_i].pre = 0>>
                    <</if>>
                    <<run _i + 1>>
                <</for>>
            <</for>>
        <</widget>>
    <</nobr>>

/* To be included on every passage, one stop call all update functions. Accepts _args[0] as noclass, etc etc. i.e. <<Updates noclass>> */
    <<nobr>>
        <<widget 'Updates'>>
            <<statsChange>>
            <<discChange>>
            <<if _args[0] != 'noclass'>>
                <<TimeCheck '0700' '0800' weekdays>>
                    <<ClassWarning Floor1_Class_Room105>>Arcane Arts class starts in less than an hour<br><</ClassWarning>>
                <</TimeCheck>>
                <<TimeCheck '0800' '0900' weekdays>>
                    <<ClassWarning Floor1_Class_Room106>>Conservation of Magic class starts in less than an hour<br><</ClassWarning>>
                <</TimeCheck>>
                <<TimeCheck '0900' '1000' weekdays>>
                    <<ClassWarning Floor1_Class_Room107>>Arcane Disciplines class starts in less than an hour<br><</ClassWarning>>
                <</TimeCheck>>
                <<TimeCheck '1000' '1100' weekdays>>
                    <<ClassWarning Floor2_Class_Room205>>Arcane Law class starts in less than an hour<br><</ClassWarning>>
                <</TimeCheck>>
                <<TimeCheck '1100' '1200' weekdays>>
                    <<ClassWarning Basement_Class_RoomB3>>Incursion Histories class starts in less than an hour<br><</ClassWarning>>
                <</TimeCheck>>
            <</if>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget 'roomComments'>>
            <<set _curPass = passage()>>
            <<switch _args[0]>>
                <<case 'clean'>>
                    <<if $roomVars[_curPass].clean <= 5>>
                        <<set _word = "spotless.">>
                        <<set _class = "legendary">>
                    
                    <<elseif $roomVars[_curPass].clean > 5 && $roomVars[_curPass].clean <= 10>>
                        <<set _word = 'pretty clean.'>>
                        <<set _class = 'rare'>>

                    <<elseif $roomVars[_curPass].clean > 10 && $roomVars[_curPass].clean <= 20>>
                        <<set _word = "a bit dirty.">>
                        <<set _class = "common">>

                    <<elseif $roomVars[_curPass].clean > 20>>
                        <<set _word = "disgusting and needs a deep cleaning.">>
                        <<set _class = "trash">>
                    <</if>>
                    <<print '<span class="' + _class + '">' + 
                        '<<hovertip "The cleaner the room, the more sanity and stamina you will gain from resting in here.">>' + 
                        _word + '<</hovertip>></span>'
                    >>

                <<case 'bed'>>
                    <<if $roomVars.Residence_Starr_PlayerRoom.bed.trash == true>>
                        <<set _word = "truly uninviting">>
                        <<set _class = "trash">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.bed.common == true>>
                        <<set _word = "average">>
                        <<set _class = "common">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.bed.uncommon == true>>
                        <<set _word = "comfortable">>
                        <<set _class = "uncommon">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.bed.rare == true>>
                        <<set _word = "premium">>
                        <<set _class = "rare">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.bed.legendary == true>>
                        <<set _word = "luxurious">>
                        <<set _class = "legendary">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.bed.unique == true>>
                        <<set _word = "regal and ostentatious">>
                        <<set _class = "unique">>

                    <</if>>
                    <<print '<span class="' + _class + '">' + 
                        '<<hovertip "The better the bed, the more stamina and lifeforce you regain per hour of rest.">>' + 
                        _word + '<</hovertip>></span>'
                    >>

                <<case 'desk'>>
                    <<if $roomVars.Residence_Starr_PlayerRoom.desk.trash == true>>
                        <<set _word = "barely usable">>
                        <<set _class = "trash">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.desk.common == true>>
                        <<set _word = "regular">>
                        <<set _class = "common">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.desk.uncommon == true>>
                        <<set _word = "attractive">>
                        <<set _class = "uncommon">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.desk.rare == true>>
                        <<set _word = "impressive">>
                        <<set _class = "rare">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.desk.legendary == true>>
                        <<set _word = "intricately">>
                        <<set _class = "legendary">>
                        
                    <<elseif $roomVars.Residence_Starr_PlayerRoom.desk.unique == true>>
                        <<set _word = "gold and lapis adorned">>
                        <<set _class = "unique">>
                    <</if>>
                    <<print '<span class="' + _class + '">' + 
                        '<<hovertip "The nicer your desk the more effectively and sanely you can study books, tomes, and manuals.">>' + 
                        _word + '<</hovertip>></span>'
                    >>

                <<case 'chair'>>
                    <<if $roomVars.Residence_Starr_PlayerRoom.chair.trash == true>>
                        <<set _word = "broken down">>
                        <<set _class = "trash">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.chair.common == true>>
                        <<set _word = "normal">>
                        <<set _class = "common">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.chair.uncommon == true>>
                        <<set _word = "nice">>
                        <<set _class = "uncommon">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.chair.rare == true>>
                        <<set _word = "very nice">>
                        <<set _class = "rare">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.chair.legendary == true>>
                        <<set _word = "really impressive">>
                        <<set _class = "legendary">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.chair.unique == true>>
                        <<set _word = "magically mastercrafted">>
                        <<set _class = "unique">>
                    <</if>>
                    <<print '<span class="' + _class + '">' + 
                        '<<hovertip "The better the build of your chair, the less sanity you lose from studying, and the more stamina you regain from just relaxing.">>' + 
                        _word + '<</hovertip>></span>'
                    >>

                <<case 'floor'>>
                    <<if $roomVars.Residence_Starr_PlayerRoom.floor.trash == true>>
                        <<set _word = "trash-like">>
                        <<set _class = "trash">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.floor.common == true>>
                        <<set _word = "semi-decent">>
                        <<set _class = "common">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.floor.uncommon == true>>
                        <<set _word = "good">>
                        <<set _class = "uncommon">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.floor.rare == true>>
                        <<set _word = "really nice">>
                        <<set _class = "rare">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.floor.legendary == true>>
                        <<set _word = "impressive">>
                        <<set _class = "legendary">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.floor.unique == true>>
                        <<set _word = "royal">>
                        <<set _class = "unique">>

                    <</if>>
                    <<print '<span class="' + _class + '">' + 
                        '<<hovertip "The better your floor, the more sanity you regain from relaxing or performing activities other than studying">>' + 
                        _word + '<</hovertip>></span>'
                    >>

                <<case 'light'>>
                    <<if $roomVars.Residence_Starr_PlayerRoom.lights.none == true>>
                        <<set _word = "not at all">>
                        <<set _class = "trash">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.lights.trash == true>>
                        <<set _word = "dimly">>
                        <<set _class = "trash">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.lights.common == true>>
                        <<set _word = "warmly">>
                        <<set _class = "common">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.lights.uncommon == true>>
                        <<set _word = "well">>
                        <<set _class = "uncommon">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.lights.rare == true>>
                        <<set _word = "brightly">>
                        <<set _class = "rare">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.lights.legendary == true>>
                        <<set _word = "impressively">>
                        <<set _class = "legendary">>

                    <<elseif $roomVars.Residence_Starr_PlayerRoom.lights.unique == true>>
                        <<set _word = "star">>
                        <<set _class = "unique">>

                    <</if>>
                    <<print '<span class="' + _class + '">' + 
                        '<<hovertip "The more well-lit your room, the less sanity lost while studying.">>' + 
                        _word + '<</hovertip>></span>'
                    >>
            <</switch>>
        <</widget>>
    <</nobr>>

    /* searchForItem i.e. searchForItem Residence_Starr_PlayerRoom (bookmisc, bookspell, bookdisc, bookskill) (mapSchool, spellBasic) (time passed)*/
    <<nobr>>
        <<widget "searchForItem">>
            <<set _room = $roomVars[_args[0]]>>
            <<set _bookType = _args[1]>>
            <<set _bookCur = _room[_bookType].cur>>
            <<set _bookMax = _room[_bookType].max>>

            <<if _bookCur < _bookMax>>
                <<foundItem _bookType _args[2]>>
                
                <<set _room[_bookType].cur += 1>>
                <<calcTime _args[3]>>
            <</if>>

            <<set _countCur = 
                _room.bookmisc.cur +
                _room.bookspell.cur +
                _room.bookdisc.cur +
                _room.bookskill.cur
            >>
            <<set _countMax = 
                _room.bookmisc.max +
                _room.bookspell.max +
                _room.bookdisc.max +
                _room.bookskill.max
            >>

            <<set _bookPerc = (100 *_countCur) / _countMax>>

            <<if _bookPerc >= 0 && _bookPerc <= 50>>
                <<print
                    '<<speech plr thought>>There is still a lot of stuff I can look through.<</speech>>'
                >>
                <<elseif _bookPerc >= 51 && _bookPerc < 100>>
                    <<print
                        '<<speech plr thought>>I\'ve searched through most of this place, but there may be more to find here.<</speech>>'
                    >>
                <<elseif _bookPerc == 100>>
                    <<print
                        '<<speech plr thought>>I have found everything there is to find here.<</speech>>'
                    >>
            <</if>>
        <</widget>>
    <</nobr>>

 /* castSpell 'target' & 'duration' &'effect' &| 'enhancement' */
    <<widget 'castSpell'>>
        <<if _args[0] && _args[1] && _args[2] && _args[3]>>
            <<set _target = _args[0]>>
            <<set _duration = _args[1]>>
            <<set _effect = _args[2]>>
            <<set _enhancement = _args[3]>>
            <<set $spellCastVar.spellDiscipline = $spellWords.effect[_effect].discipline>>
            <<set $spellCastVar.spellCost = 
                $spellWords.target[_target].costMult *
                ($spellWords.effect[_effect].costMult - ($plr.disciplines[$spellCastVar.spellDiscipline].level * 0.1)) *
                $spellWords.duration[_duration].costMult *
                $spellWords.enhancement[_enhancement].costMult
            >>
            <<run $spellWords.effect[_effect].badCombo()>>
            
            <<if $spellCastVar.spellCost <= $plr.stats.stamina.cur && $spellCastVar.spellCost <= $plr.stats.focus.cur && !$spellCastVar.badCombo>>
                <<if _target == 'self' || _target == 'other'>>
                    <<run $spellWords.effect[_effect].onCast()>>

                <</if>>

                <<set _disc = $spellCastVar.spellDiscipline>>
                <<set _discChange = $spellCastVar.spellCost * 0.2>>
                <<setDisc 'plr' _disc _discChange>>

                <<set _stamChange = $spellCastVar.spellCost * -1>>
                <<setStats 'plr' 'stamina' _stamChange>>
                

                <<set $plr.stats.stamina.max += $spellCastVar.spellCost * 0.1>>
                <<set $plr.stats.focus.max += $spellCastVar.spellCost * 0.05>>

                <<removeclass '#spell-result'>>
                <<addclass '#spell-result' 'green'>>
                <<replace '#spell-result'>>I successfully cast my spell!<</replace>>

                <<if _target == 'room' && tags().includes('room')>>
                    <<run $spellWords.effect[_effect].onCast()>>
                    <<goto 'Spell_Success'>>
                    <<run Dialog.close()>>
                    
                <</if>>

                <<if $eventVar.inCombat == true>>
                    <<goto[[Spell_Combat]]>>
                    <<run Dialog.close()>>
                <</if>>
                
            <<elseif $spellCastVar.spellCost > $plr.stats.stamina.cur>>
                <<removeclass '#spell-result'>>
                <<addclass '#spell-result' 'red'>>
                <<replace '#spell-result'>>I am too tired to cast the spell I want to.<</replace>>

            <<elseif $spellCastVar.spellCost > $plr.stats.focus.cur>>
                <<removeclass '#spell-result'>>
                <<addclass '#spell-result' 'red'>>
                <<replace '#spell-result'>>I do not have the mental focus required to cast a spell of this power.<</replace>>

            <<elseif $spellCastVar.badCombo>>
                <<removeclass '#spell-result'>>
                <<addclass '#spell-result' 'orange'>>
                <<replace '#spell-result'>>$spellCastVar.badCombo<</replace>>

            <</if>>
        <<else>>
            <<removeclass '#spell-result'>>
            <<addclass '#spell-result' 'purple'>>
            <<replace '#spell-result'>>Half-baked spells are guaranteed to go spectacularly wrong... I should complete my choice of Words.<</replace>>

        <</if>>
    <</widget>>

/* Right Menu Stats Comment Section, <<statsComments (stat)>> */
    <<nobr>>
        <<widget 'statsComments'>>
            <<set _totalV = $plr.stats[_args[0]].max>>
            <<set _compV = $plr.stats[_args[0]].cur>>

            <<set _percV = (100 * _compV) / _totalV>>
            <<set _dispV = _percV.toFixed(0)>>
            <<if _args[0] == 'stamina'>>
                <<if _dispV >= 80>>
                    <<replace '#stamina-comment'>>
                        <span class = "green">I am feeling energized and ready for anything.</span>
                    <</replace>>
                <</if>>
                <<if _dispV >= 50 && _dispV < 80>>
                    <<replace '#stamina-comment'>>
                        <span class = "yellow">I am feeling a little tired, but nothing serious.</span>
                    <</replace>>
                <</if>>
                <<if _dispV >= 30 && _dispV < 50>>
                    <<replace '#stamina-comment'>>
                        <span class = "orange">I am getting really tired, a little rest sounds real good.</span>
                    <</replace>>
                <</if>>
                <<if _dispV < 30 >>
                    <<replace '#stamina-comment'>>
                        <span class = "red">I am exhausted and need to chill out for awhile.</span>
                    <</replace>>
                <</if>>
            <</if>>
            <<if _args[0] == 'life'>>
                <<if _dispV >= 80>>
                    <<replace '#life-comment'>>
                        <span class = "green">I don't have a scratch on me.</span>
                    <</replace>>
                <</if>>
                <<if _dispV >= 50 && _dispV < 80>>
                    <<replace '#life-comment'>>
                        <span class = "yellow">I have some cuts and bruises.</span>
                    <</replace>>
                <</if>>
                <<if _dispV >= 30 && _dispV < 50>>
                    <<replace '#life-comment'>>
                        <span class = "orange">I\'m missing enough blood to be concerned at this point.</span>
                    <</replace>>
                <</if>>
                <<if _dispV < 30 >>
                    <<replace '#life-comment'>>
                        <span class = "red">I am in need of urgent medical care.</span>
                    <</replace>>
                <</if>>
            <</if>>
            <<if _args[0] == 'focus'>>
                <<if _dispV >= 80>>
                    <<replace '#focus-comment'>>
                        <span class = "green">I am completely focused.</span>
                    <</replace>>
                <</if>>
                <<if _dispV >= 50 && _dispV < 80>>
                    <<replace '#focus-comment'>>
                        <span class = "yellow">My mind wanders just a little.</span>
                    <</replace>>
                <</if>>
                <<if _dispV >= 30 && _dispV < 50>>
                    <<replace '#focus-comment'>>
                        <span class = "orange">It is getting difficult to focus.</span>
                    <</replace>>
                <</if>>
                <<if _dispV < 30 >>
                    <<replace '#focus-comment'>>
                        <span class = "red">I am spent and desperately in need of some me time.</span>
                    <</replace>>
                <</if>>
            <</if>>
            <<if _args[0] == 'sanity'>>
                <<if _dispV >= 80>>
                    <<replace '#sanity-comment'>>
                        <span class = "green">Both feet are firmly planted in reality.</span>
                    <</replace>>
                <</if>>
                <<if _dispV >= 50 && _dispV < 80>>
                    <<replace '#sanity-comment'>>
                        <span class = "yellow">I might have seen two black cats. Or was it deja vu?</span>
                    <</replace>>
                <</if>>
                <<if _dispV >= 30 && _dispV < 50>>
                    <<replace '#sanity-comment'>>
                        <span class = "orange">Am I starting to lose my mind?</span>
                    <</replace>>
                <</if>>
                <<if _dispV < 30 >>
                    <<replace '#sanity-comment'>>
                        <span class = "red">My grasp on reality is slipping...</span>
                    <</replace>>
                <</if>>
            <</if>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget 'processClean'>>
            <<for _i, _name range $roomVars>>
                <<set $roomVars[_i].clean += $dateTime.minPassed * 0.007>>
                <<run _i += 1>>
            <</for>>
        <</widget>>
    <</nobr>>

    /*Console log in a widget, i.e. <<consolelog lifecur _life */
    <<nobr>>
        <<widget 'consolelog'>>
            <<if $systemVar.logs == true>>
                <<if _args[0] && _args[1] !== void(0) >>
                    <<run console.log(_args[0] + ': ' + _args[1])>>
                    <<else>>
                        <<run console.log(_args[0])>>
                <</if>>
            <</if>>
        <</widget>>
    <</nobr>>

    /* Calculates player power score for use in encounter calculations and some npc interactions, i.e. <<PowerScore>> */
    <<nobr>>
        <<widget 'PowerScore'>>
            <<set _discPower = 0>>

            <<for _i, _name range $plr.disciplines>>
                <<if $plr.disciplines[_i].level>>
                    <<set _discPower += $plr.disciplines[_i].level>>
                <</if>>
                <<run _i + 1>>
            <</for>>

            <<set _powerScore = 
                _discPower + 
                ($plr.stats.stamina.max * 1.5) + 
                ($plr.stats.life.max * 1.5) + 
                ($plr.stats.focus.max * 1.5) + 
                $plr.stats.sanity.max
            >>
            <<set $plr.powerScore = _powerScore.toFixed(1)>>
            <<consolelog '$plr.powerScore' $plr.powerScore>>
        <</widget>>
    <</nobr>>

    /* Creates and updates enemy stat bars for combat, i.e. <<enemyStatBars angrySquirrel>> */
    <<nobr>>
        <<widget 'enemyStatBars'>>
            <<set _statAddr = $critters[_args[0]].stats>>
            <<set _stamMax = _statAddr.stamina.max>>
            <<set _stamCur = _statAddr.stamina.cur>>
            <<set _lifeMax = _statAddr.life.max>>
            <<set _lifeCur = _statAddr.life.cur>>
            <<set _enemyName = $critters[_args[0]].name.firstName>>

            <<replace '#enemyName'>>_enemyName<</replace>>
            <<run $critters[_args[0]].img()>>
            <<run EnemyStamina(_stamCur, _stamMax)>>
            <<run EnemyLife(_lifeCur, _lifeMax)>>
        <</widget>>
    <</nobr>>

    /* <<CombatStart 'tinyImp' */
    <<nobr>>
        <<widget 'CombatStart'>>
            <<run $spellCastVar.availableTargets.critters.pushUnique('tinyImp')>>
            <<enemyStatBars 'tinyImp'>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget 'CombatEnd'>>
            <<if $spellCastVar.spellTarget.stats.life.cur <= 0>>                
                <<for _i, _name range $critters>>
                    <<set _critter = $critters[_i]>>
                    <<set _critter.stats.life.cur = _critter.stats.life.max>>
                    <<set _critter.stats.stamina.cur = _critter.stats.stamina.max>>
                    <<run _i + 1>>
                <</for>>

                <<set $eventVar.combatPass = ''>>
                <<set $eventVar.inCombat = false>>

                <<set _enemyLoot = $spellCastVar.spellTarget.stats.life.max + random(1, 3)>>
                <<pickup $plrCurrencies 'goldflake' _enemyLoot>>

                <<run
                    Dialog.setup('Foe Defeated');
                    Dialog.wiki('You have defeated a ' + $spellCastVar.spellTarget.name.firstName + '. Your enemy\'s body dissolved, but left behind <span class="yellow">' + _enemyLoot + ' gold flakes</span>, which you happily picked up.');
                    Dialog.open();
                >>

                <<set $spellCastVar.availableTargets.critters = []>>
                <<set $spellCastVar.spellTarget = ''>>
                <<set $unlockVar.userInterface.locations = true>>
            <</if>>
        <</widget>>
    <</nobr>>

    /* -----OBSOLETE NpcAvailable OBSOLETE-----*/
    <<nobr>>
        <<widget 'NpcAvailable'>>
            <<consolelog '-----NpcAvailable Start-----'>>
            <<set _npc = _args[0].charAt(0).toUpperCase() + _args[0].slice(1)>>
            <<if $eventVar.eventactive != true>>
                <<if _args[1] != 'random'>>
                    <<set _event ='Conversation_' + _args[1]>>
                    <<set _eventCheck = $unlockVar.conversations[_args[1]]>>
                <</if>>

                <<consolelog '_npc' _npc>>
                <<consolelog '_event' _event>>
                <<consolelog  '_event Completed' _eventCheck>>

                <<if _event && _eventCheck == false>>
                    <<include _event>>
                    <<set $unlockVar.conversations[_args[1]] = true>>
                    <<consolelog 'Event Convo: Selected'>>
                    <<set $eventVar.eventactive = true>>
                <<elseif _args[1] == 'allowrandom' || _args[2] == 'allowrandom'>>
                    <<set _eventRandom = 'Conversation_' + _npc + '_Random'>>
                    <<include _eventRandom>>
                    <<consolelog 'Random Convo: Selected'>>
                    <<set $eventVar.eventactive = true>>
                <</if>>
            <<else>>
                <<consolelog 'Convo Already in-Progress'>>
            <</if>>
            <<print '<div class="w3-panel w3-text-red w3-black">Use the new "spawnevent", idiot...</div>'>>
            <<consolelog '---NpcAvailable End---'>>
        <</widget>>
    <</nobr>>

    /* Adjusts npc conversation greeting according to relationship stats. <<NpcRelationGreet janessa>> */
    <<nobr>>
        <<widget 'NpcRelationGreet'>>
            <<consolelog '-----NpcRelationGreet Start-----'>>
            <<set _relPos = $plr.relations[_args[0]].positive>>
            <<set _relNeg = $plr.relations[_args[0]].negative>>
            <<set _relInt = $plr.relations[_args[0]].intimate>>
            <<set _relSus = $plr.relations[_args[0]].suspicion>>
            <<set _npcPersonality = $npcs[_args[0]].personality>>
            <<consolelog '_npcPersonality' _npcPersonality>>

            <<set _greetingAry = $personalityList[_npcPersonality].greetings>>
            <<set _rando = random(0, (_greetingAry.length - 1))>>

            <<consolelog '_rando' _rando>>

            <<set _greeting = _greetingAry[[_rando]]>>

            <<print _greeting>>

            <<consolelog '_greeting' _greeting>>
            <<consolelog '-----NpcRelationGreet End-----'>>
        <</widget>>
    <</nobr>>

    /* Adjusts npc conversation goodbye according to relationship stats. <<NpcRelationBye janessa>> */
    <<nobr>>
        <<widget 'NpcRelationBye'>>
        
        <</widget>>
    <</nobr>>

    /* Adjusts npc conversation comments according to relationship stats. <<NpcRelationCmt janessa>> */
    <<nobr>>
        <<widget 'NpcRelationCmt'>>
            
        <</widget>>
    <</nobr>>

    /* Sets available random events and runs based on multiple args, i.e. <<randomEvent (standard event) >> */
    <<nobr>>
        <<widget 'randomEvent'>>
            <<set _standardEvent = _args[0]>>
            <<set _randEventNum = random(1, 3)>>
            <<set _randNum = random(1, 10)>>
            <<set _eventArray = $roomVars[passage()].randomEvents>>
            <<if $dateTime.hour >= 6 && $dateTime.hour <= 19>>
                <<set _curTime = 'day' + _randEventNum>>
                <<else>>
                    <<set _curTime = 'night' + _randEventNum>>
            <</if>>

            <<for _i = 0; _i < _eventArray.length; _i++>>
                <<if tags(_eventArray[_i]).includes(_curTime) && _randNum <= 3>>
                    <<set _curRndEvent = _eventArray[_i]>>
                    <<if _curRndEvent>>
                        <<break>>
                    <</if>>

                    <<else>>
                        <<set _curRndEvent = _standardEvent>>
                <</if>>
            <</for>>
            <<if tags(_curRndEvent).includes('combat')>>
                <<set $eventVar.inCombat = true>>
                <<set $unlockVar.userInterface.locations = false>>
                <<set $eventVar.combatPass = _curRndEvent>>
            <</if>>
            <<include _curRndEvent>>
            <<consolelog 'Random Event' _curRndEvent>>

        <</widget>>
    <</nobr>>

    /* Initiate event with optional random content
        i.e. <<spawnevent 0:npc 1:Janessa_CourseOverview 2:norandom 3:'0600' 4:'0800'>> 
        i.e. <<spawnevent 0:location 1:Residence_Starr_Courtyard_KyleIntroduction 2:Residence_Starr_Courtyard_Random 3:'0000' 4:'2400'>>
        i.e. <<spawnevent 0:npc 1:Janessa_Random 2:Janessa_Random 3:'0000' 4:'2400'>>
    */
    <<nobr>>
        <<widget "spawnevent">>
            <<set _type = _args[0]>>
            <<set _event = _args[1]>>
            <<set _randomevent = _args[2]>>
            <<set _timestart = _args[3]>>
            <<set _timeend = _args[4]>>
            <<if $dateTime.hour > 6 && $dateTime.hour <= 19>>
                <<set _daynight = 'day'>>
            <<else>>
                <<set _daynight = 'night'>>
            <</if>>
            <<set $eventVar.timeofday = _daynight>>

            <<TimeCheck _timestart _timeend>>
                <<switch _type>>
                    <<case 'npc'>>
                        <<if $eventVar.eventactive == false>>
                            <<set _event = 'Conversation_' + _event>>

                            <<if !tags(_event).includes('random')>>
                                <<set _eventcheck = $unlockVar.conversations[_event]>>
                            <</if>>
                            
                            <<if _event && _eventcheck != true>>
                                <<include _event>>
                                <<set $unlockVar.conversations[_event] = true>>
                                <<set $eventVar.eventactive = true>>
                                <<consolelog 'Specific NPC Event Fired' _event>>

                            <<elseif _randomevent != 'forbidrandom'>>
                                <<set _randomevent = 'Conversation_' + _randomevent>>
                                <<include _randomevent>>
                                <<set $eventVar.eventactive = true>>

                                <<consolelog 'Random NPC Event Fired' _randomevent>>
                            <<else>>
                                <<consolelog 'Random NPC Event: Forbid'>>
                            <</if>>
                        <<elseif $eventVar.eventactive == true>>
                            <<consolelog 'NPC Event Already Fired: Repeat Attempted'>>
                        <</if>>

                    <<case 'location'>>
                        <<if $eventVar.eventactive == false>>
                            <<if !tags(_event).includes('random')>>
                                <<set _eventcheck = $unlockVar.placeevents[_event]>>
                            <</if>>

                            <<if _event && _eventcheck != true>>
                                <<include _event>>
                                <<set $unlockVar.placeevents[_event] = true>>
                                <<set $eventVar.eventactive = true>>
                                <<consolelog 'Specific Location Event Fired' _event>>

                            <<elseif _randomevent != 'forbidrandom'>>
                                <<include _event>>
                                <<set $eventVar.eventactive = true>>
                                <<consolelog 'Random Location Event Fired' _event>>
                            
                            <<else>>
                                <<consolelog 'Random Loc Event: Forbid'>>

                            <</if>>
                        <<elseif $eventVar.eventactive == true>>
                            <<consolelog 'Location Event Already Fired: Repeat Attempted'>>
                        <</if>>
                <</switch>>
            <</TimeCheck>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "GenerateCourseTbl">>
            <<set _courseTitle = $courses[_args[0]].title>>
            <<set _courseRoom = $courses[_args[0]].classroom>>
            <<set _roomNum = $courses[_args[0]].roomNum>>
            <<set _courseInstructor = $courses[_args[0]].instructor>>
            <<set _courseStart = $courses[_args[0]].startTime>>
            <<set _courseEnd = $courses[_args[0]].endTime>>

            <<run 
                if(_courseStart.toString().length < 4) {
                    _courseStart = '0' + _courseStart
                };
                if(_courseEnd.toString().length < 4) {
                    _courseEnd = '0' + _courseEnd
                }
            >>
            <<set _details ='Room ' + _roomNum + '<br>' + _courseStart + '-' + _courseEnd + '<br>' + $npcs[_courseInstructor].name.formal>>
            <<hovertip _details>>
                <<if $unlockVar.locations[_courseRoom].unlocked == true>>
                    <<link _courseTitle _courseRoom>>
                        <<calcTime 5 10>>
                    <</link>>
                    <<else>>
                        _courseTitle
                <</if>>
            <</hovertip>>
        <</widget>>
    <</nobr>>

    /*Allows content based on start time, end time, day, month, year or false for anything but start/end times i.e. <<TimeCheck 1100 1300 thursday april 3 2024>>Its time!<</TimeCheck>>*/
    <<nobr>>
        <<widget 'TimeCheck' container>>

            <<set _start = Number(_args[0].slice(0, 2))>>
            <<set _end = Number(_args[1].slice(0, 2))>>

            <<set _startCombo = Number(_args[0])>>
            <<set _endCombo = Number(_args[1])>>

            <<if $dateTime.min >= 10>>
                <<set _sysTime = Number($dateTime.hour.toString() + $dateTime.min.toString())>>
            <<elseif $dateTime.min < 10>>
                <<set _sysTime = Number($dateTime.hour.toString() + '0' + $dateTime.min.toString())>>
            <</if>>

            <<if _args[2] != false>>
                <<set _dayName = _args[2]>>
            <</if>>
            <<if _args[3] != false>>
                <<set _month = _args[3]>>
            <</if>>
            <<if _args[4] != false>>
                <<set _day = _args[4]>>
            <</if>>
            <<if _args[5] != false>>
                <<set _year = _args[5]>>
            <</if>>

            <<if _year && _month && _day>>
                <<if _year == $dateTime.year && _month == $dateTime.monthName && _day == $dateTime.date && _sysTime >= _startCombo && _sysTime < _endCombo>>
                        _contents
                        <<set _d = 'Check: Year/Month/Date'>>
                <</if>>

            <<elseif _month && _day>>
                <<if _month == $dateTime.monthName && _day == $dateTime.date && _sysTime >= _startCombo && _sysTime < _endCombo>>
                    _contents
                    <<set _d = 'Check: Month/Date'>>
                <</if>>

            <<elseif _month && _dayName && _dayName != 'weekdays' && _dayName != 'weekend' && _dayName != 'cycle' && _dayName != 'cycleNoWeekend'>>
                <<if _month == $dateTime.monthName && _dayName == $dateTime.dayName && _sysTime >= _startCombo && _sysTime < _endCombo>>
                    _contents
                    <<set _d = 'Check: Month/DayName'>>
                <</if>>
        
            <<elseif _dayName && _dayName != 'weekdays' && _dayName != 'weekend' && _dayName != 'cycle' && _dayName != 'cycleNoWeekend'>>
                <<if _dayName == $dateTime.dayName && _sysTime >= _startCombo && _sysTime < _endCombo>>
                    _contents
                    <<set _d = 'Check: DayName'>>
                <</if>>

            <<elseif _dayName == 'weekdays'>>
                <<if _sysTime >= _startCombo && _sysTime < _endCombo && ($dateTime.dayName == 'Monday' || $dateTime.dayName == 'Tuesday' || $dateTime.dayName == 'Wednesday' || $dateTime.dayName == 'Thursday' || $dateTime.dayName == 'Friday')>>
                    _contents
                    <<set _d = 'Check: Weekdays'>>
                <</if>>

            <<elseif _dayName == 'weekend'>>
                <<if _sysTime >= _startCombo && _sysTime < _endCombo && ($dateTime.dayName == 'Saturday' || $dateTime.dayName == 'Sunday')>>
                    _contents
                    <<set _d = 'Check: Weekend'>>
                <</if>>

            <<elseif _dayName == 'cycle'>>
                <<if (_sysTime <= _startCombo && $dateTime.hour >= 0) || (_sysTime >= _endCombo && $dateTime.hour < 24)>>
                    _contents
                    <<set _d = 'Check: Cycle'>>
                <</if>>
        
            <<elseif _dayName == 'cycleNoWeekend'>>
                <<if (_sysTime < _startCombo && $dateTime.hour >= 0) || (_sysTime >= _endCombo && $dateTime.hour < 24) || $dateTime.dayName == 'Saturday' || $dateTime.dayName == 'Sunday'>>
                    _contents
                    <<set _d = 'Check: Cycle w/ No Weekend'>>
                <</if>>
            
            <<elseif _sysTime >= _startCombo && _sysTime < _endCombo>>
                        _contents
                        <<set _d = 'Check: Time Only'>>
            <</if>>

            <<if $systemVar.timecheck == true>>
                <<consolelog '---TimeCheck Start---'>>
                <<consolelog '_args[0]' _args[0]>>
                <<consolelog '_args[1]' _args[1]>>
                <<consolelog '_start' _start>>
                <<consolelog '_end' _end>>
                <<consolelog '_sysTime' _sysTime>>
                <<consolelog '_startCombo' _startCombo>>
                <<consolelog '_endCombo' _endCombo>>
                <<consolelog 'Selector' _d>>
                <<consolelog '-----TimeCheck End-----'>>
            <</if>>
        <</widget>>
    <</nobr>>

    /* Takes two args, one for end hour and another for  prior to display warning message, i.e. <<TimeWarning Floor1_Class_Room105>>Class is soon!<</TimeWarning>> */
    <<nobr>>
        <<widget "ClassWarning" container>>
            <<if passage() != _args[0]>>
                <span class='yellow'><i>_contents</i></span>
            <</if>>
        <</widget>>
    <</nobr>>

    /* <<ClassLectures arcanelaw101>> */
    <<nobr>>
        <<widget "ClassLectures">>
            <<consolelog '---ClassLectures Start---'>>

            <<set _course = $courses[_args[0]].passage>>
            <<set _courseNum = $courses[_args[0]].passageNum>>
            <<set _coursePas = 'Course_' + _course + '_' + _courseNum>>

            <<consolelog 'Passage #' _courseNum>>
            <<consolelog 'Passage ID' _coursePas>>

            <<include _coursePas>>

            <<set $courses[_args[0]].passageNum += 1>>

            <<consolelog '-----ClassLectures End-----'>>
        <</widget>>
    <</nobr>>

    /* Calculates difference in time to move an exact future hour and min(optional), i.e. <<SetTime 8 30>> */
    <<nobr>>
        <<widget "SetTime">>
            <<consolelog '---SetTime Start---'>>
            <<if _args[1]>>
                <<set _minSet = _args[1]>>
            <<else>>
                <<set _minSet = 0>>
            <</if>>
            <<consolelog '_minSet' _minSet>>
            <<set _hourSet = _args[0]>>
            <<set _currentMin = $dateTime.min>>
            <<set _preHr = _args[0] - $dateTime.hour>>
            <<if _preHr != 0>>
                <<set _preMin = 60 * _preHr + _minSet>>
            <<else>>
                <<set _preMin = _minSet>>
            <</if>>
            <<set _result = _preMin - _currentMin>>


            <<calcTime _result false>>

            <<consolelog '_preHr' _preHr>>
            <<consolelog '_preMin' _preMin>>
            <<consolelog '_result' _result>>
            <<consolelog '-----SetTime End-----'>>
        <</widget>>
    <</nobr>>

    /* Prints player name with one args, i.e. <<Player formal || first || full>> */
    <<nobr>>
        <<widget "Player">>
            <<if _args[1] == 'p'>>
                <<set _period = '.'>>
            <<else>>
                <<set _period = ''>>
            <</if>>
            <<if _args[0] == 'formal'>>
               <<print $plr.name.formal + _period>>
            <<elseif _args[0] == 'first'>>
                <<print $plr.name.firstName + _period>>
            <<elseif _args[0] == 'full'>>
                <<print $plr.name.fullName() + _period>>
            <</if>>
        <</widget>>
    <</nobr>>

    /* Uses a skill, i.e. <<UseSkill mundane meditation>> */
    <<nobr>>
        <<widget "UseSkill">>
            <<consolelog '---<<UseSkill Start>>---'>>
            <<set _lvl = $plr.skills[_args[0]][_args[1]].level>>
            <<set _skillName = $skillVars[_args[1]].title>>
            <<set _skillDesc = $skillVars[_args[1]].description>>
            <<if _lvl == 0>>
                <<set _lvl = 5>>
                <<set $plr.skills[_args[0]][_args[1]].level = 5>>
                <<else>>
                    <<set _r = (30 / _lvl) * (1 / 2)>>
                    <<set $plr.skills[_args[0]][_args[1]].level += _r>>
            <</if>>

            <<switch _args[1]>>
                <<case 'meditation'>>
                    <<set _s = $plr.stats.stamina.cur + (_lvl * 0.5)>>
                    <<set _f = $plr.stats.focus.cur + (_lvl * 0.2)>>
                    <<set _n = $plr.stats.sanity.cur + (_lvl * 0.2)>>
                    <<calcTime 5 0 false>>
                
                    <<setStats plr stamina _s>>
                    <<setStats plr focus _f>>
                    <<setStats plr sanity _n>>

                    <<goto Skills_Meditation_Use>>

                    <<consolelog 'UseSkill: Meditation'>>
                <<default>>
                    <<consolelog 'UseSkill: Default Case'>>
            <</switch>>
            <<consolelog '-----<<UseSkill End>>-----'>>
        <</widget>>
    <</nobr>>

