:: Widgets[widget]

    /* relGain Amy 10 */
    <<widget "relGain">>
        <<set $plrRel[_args[0]] += _args[1] + ($plrBody.dynamic.atttractiveness / 10)>>
        <<set $relNpcTemp = _args[0]>>
        <<set $relAmtTemp = _args[1]>>
    <</widget>>

    <<nobr>>
    <<widget "printRelGain">>
            <<if $relAmtTemp>>
                <<if $relAmtTemp > 0 >>
                    <<print '<span class="green">Your relationship with ' +  $npcs[$relNpcTemp].formal + ' has improved!</span>'>>
                <<else>>
                    <<print '<span class="red">Your relationship with ' + $npcs[$relNpcTemp].formal + ' has deteriorated.</span>'>>
                <</if>>
                <<unset $relAmtTemp, $relNpcTemp>>
            <</if>>
    <</widget>>
    <</nobr>>

    <<widget "calcAttractiveness">>
        <<nobr>>
            <<set $plrBody.dynamic.atttractiveness = 0>>
            <<if $plrBody.static.sex == "male" && ($plrBody.static.height == "tall" || $plrBody.static.height == "very tall")>>
                <<set $plrBody.dynamic.atttractiveness += 10>>
            <<elseif $plrBody.static.sex == "female" && ($plrBody.static.height == "average" || $plrBody.static.height == "short")>>
                <<set $plrBody.dynamic.atttractiveness += 10>>
            <</if>>

            <<if $plrBody.static.faceShape == "oblong" || $plrBody.static.faceShape == "square">>
                <<set $plrBody.dynamic.atttractiveness += 10>>
            <</if>>

            <<if $plrBody.dynamic.weight >= 20 && $plrBody.dynamic.weight <= 55>>
                <<set $plrBody.dynamic.atttractiveness += 10>>
            <</if>>

            <<if $plrBody.static.sex == "female">>
                <<set $plrBody.dynamic.atttractiveness *= 1.1>>
        <</if>>
        <</nobr>>
    <</widget>>

    /* calcTime 20(increase in minutes) 5(random extra minutes) */
    <<nobr>>
        <<widget "calcTime">>
                <<if _args[1]>>
                    <<set $dateTime.min += _args[0] + random(_args[1])>>
                <<elseif _args[0]>>
                    <<set $dateTime.min += _args[0]>>
                <</if>>
                <<if $dateTime.min >= 60>>
                    <<set $dateTime.hour += 1>>
                    <<set $dateTime.min -= 60>>
                <</if>>
                <<if $dateTime.hour >= 24>>
                    <<set $dateTime.date += 1>>
                    <<set $dateTime.hour -= 24>>
                    <<set $dateTime.day += 1>>
                <</if>>
                <<if $dateTime.day > 7 >>
                    <<set $dateTime.day = 1>>
                <</if>>
                <<if $dateTime.date > 30>>
                    <<set $dateTime.month += 1>>
                    <<set $dateTime.date -= 30>>
                <</if>>
                <<if $dateTime.month > 12 >>
                    <<set $dateTime.year += 1>>
                    <<set $dateTime.month = 1>>
                <</if>>

                <<replace "#timeplusdate">>
                    <<if $dateTime.day == 1>>
                        <<set $dateTime.dayName = "Monday">>
                    <</if>>
                    <<if $dateTime.day == 2>>
                        <<set $dateTime.dayName = "Tuesday">>
                    <</if>>
                    <<if $dateTime.day == 3>>
                        <<set $dateTime.dayName = "Wednesday">>
                    <</if>>
                    <<if $dateTime.day == 4>>
                        <<set $dateTime.dayName = "Thursday">>
                    <</if>>
                    <<if $dateTime.day == 5>>
                        <<set $dateTime.dayName = "Friday">>
                    <</if>>
                    <<if $dateTime.day == 6>>
                        <<set $dateTime.dayName = "Saturday">>
                    <</if>>
                    <<if $dateTime.day == 7>>
                        <<set $dateTime.dayName = "Sunday">>
                    <</if>>
                    <<if $dateTime.month == 1>>
                        <<set $dateTime.monthName = "January">>
                    <</if>>
                    <<if $dateTime.month == 2>>
                        <<set $dateTime.monthName = "February">>
                    <</if>>
                    <<if $dateTime.month == 3>>
                        <<set $dateTime.monthName = "March">>
                    <</if>>
                    <<if $dateTime.month == 4>>
                        <<set $dateTime.monthName = "April">>
                    <</if>>
                    <<if $dateTime.month == 5>>
                        <<set $dateTime.monthName = "May">>
                    <</if>>
                    <<if $dateTime.month == 6>>
                        <<set $dateTime.monthName = "June">>
                    <</if>>
                    <<if $dateTime.month == 7>>
                        <<set $dateTime.monthName = "July">>
                    <</if>>
                    <<if $dateTime.month == 8>>
                        <<set $dateTime.monthName = "August">>
                    <</if>>
                    <<if $dateTime.month == 9>>
                        <<set $dateTime.monthName = "September">>
                    <</if>>
                    <<if $dateTime.month == 10>>
                        <<set $dateTime.monthName = "October">>
                    <</if>>
                    <<if $dateTime.month == 11>>
                        <<set $dateTime.monthName = "November">>
                    <</if>>
                    <<if $dateTime.month == 12>>
                        <<set $dateTime.monthName = "December">>
                    <</if>>
                    <<if $dateTime.hour <= 9 && $dateTime.min <= 9>>
                        <<print '<br>0' + $dateTime.hour + ':0' + $dateTime.min + '<br>'>>
                    <<elseif $dateTime.hour <= 9>>
                        <<print '<br>0' + $dateTime.hour + ':' + $dateTime.min + '<br>'>>
                    <<elseif $dateTime.min <= 9>>
                        <<print '<br>' + $dateTime.hour + ':0' + $dateTime.min + '<br>'>>
                    <<else>>
                        <<print '<br>' + $dateTime.hour + ':' + $dateTime.min + '<br>'>>
                    <</if>>
                    <<print $dateTime.dayName + ' ' + $dateTime.monthName + ' ' + $dateTime.date + ', ' + $dateTime.year + '<br>'>>
                <</replace>>
        <</widget>>
    <</nobr>>

    /* readBook itemtype (miscbook, skillbook, spellbook, recipebook, lorebook) itemID spellschool(abjuration, illusion, etc.) */
    <<nobr>>
        <<widget "readBook">>
            <<switch _args[0]>>
                <<case "miscbook">>
                    <<if $bookMisc[_args[1]].pagesRead != $bookMisc[_args[1]].pagesTotal>>
                        <<set $bookMisc[_args[1]].pagesRead += 1>>

                        <<pickup $plrinvbooks _args[1] 1>>
                        <<calcTime 20 15>>

                        <<set _unlocknum = $bookMisc[_args[1]].pagesRead>>
                        <<set _unlockname = $bookMisc[_args[1]].pageUnlocks[_unlocknum]>>
                        <<set _unlockmessage = $unlockVar.locations[_unlockname].name>>

                        <<if _unlockname == undefined>>
                            <<set _unlockmessage = "nothing, but there are more chapters to read">>
                        <</if>>
                        <<run
                            Dialog.setup("Chapter Read");
                            Dialog.wiki("After reading chapter " + _unlocknum + "/" + $bookMisc[_args[1]].pagesTotal + " of " + "'" + $bookMisc[_args[1]].title + "'" + " you discovered " + _unlockmessage + ".");
                            Dialog.open();
                        >>
                        <<set $unlockVar.locations[_unlockname].unlocked = true>>
                    <<else>>
                        <<drop $plrinvbooks _args[1] 1>>
                        <<run UI.alert("You finished the book, there is nothing left to learn from this.")>>
                    <</if>>

                <<case "skillbook">>


                <<case "spellbook">>
                    <<set _address = $bookDisciplines[_args[3]][_args[1]]>>
                    <<if [_address].pagesRead != [_address].pagesTotal>>
                        <<set [_address].pagesRead += 1>>

                        <<pickup $plrinvbooks _args[1]>>
                        <<calcTime 30 30>>

                        <<set _unlocknum = [_address].pagesRead>>
                        <<set _unlockname = [.address].pageUnlocks[_unlocknum]>>
                        <<set _unlockmessage = $unlockVar.spellsBasic[_unlockname].name>>

                        <<if _unlockname == undefined>>
                            <<set _unlockmessage = "nothing, but there is more in this to study">>
                        <</if>>

                        <<run
                            Dialog.setup("Spell Tome Studied");
                            Dialog.wiki("After reading chapter " + _unlocknum + "/" + [_address].pagesTotal + " of " + "'" + [_address].title + "'" + " you learned how to cast the " + _unlockmessage + " spell!");
                            Dialog.open();
                        >>
                        <<set $spellDetails.spellsBasic.illusion[_unlockname].unlocked = true>>
                    <<else>>

                        <<drop $plrinvbooks _args[1]>>
                        <<run UI.alert("You have already gleamed all you can from this tome.")>>
                    <</if>>

                <<case "recipebook">>


                <<case "lorebook">>


            <</switch>>
        <</widget>>
    <</nobr>>

    /* foundItem itemtype(miscbook, skillbook, material, misc, spellbook) itemID*/
    <<nobr>>
        <<widget "foundItem">>
            <<switch _args[0]>>
                <<case "miscbook">>
                    <<run 
                        Dialog.setup("Book Found");
                        Dialog.wiki("You found a book titled '<b>" + $bookMisc[_args[1]].title + "</b>.'" + "<br><br>" + " The first page reads '<i>" + $bookMisc[_args[1]].description + "</i>'.");
                        Dialog.open();
                    >>
                    <<pickup $plrinvbooks _args[1] 1>>

                <<case "material">>
                    <<set _address = $itemMaterial._args[1]>>
                    <<run 
                        Dialog.setup("Material Found");
                        Dialog.wiki("You found some " + _address.title + ".");
                        Dialog.open();
                    >>
                    <<pickup $plrinvmaterials _args[1] 1>>

                <<case "misc">>
                    <<set _address = $itemMisc._args[1]>>
                    <<run 
                        Dialog.setup("Item Found");
                        Dialog.wiki("You found a " + _address.title + ".");
                        Dialog.open();
                    >>
                    <<pickup $plrinvmisc _args[1] 1>>

                <<case "spell">>
                    <<set _address = $tbd._args[1]>>

            <</switch>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "tone" container>>
                <<if _args[0] == "neg">>
                    <span class="negTone">
                        [_contents]
                    </span>
                <<elseif _args[0] == "pos">>
                    <span class="posTone">
                        [_contents]
                    </span>
                <</if>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "setStamina">>
            <<set $plrStats.stamina.cur = _args[0]>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "setLife">>
            <<set $plrStats.life.cur = _args[0]>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "setFocus">>
            <<set $plrStats.focus.cur = _args[0]>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "setSanity">>
            <<set $plrStats.sanity.cur = _args[0]>>
        <</widget>>
    <</nobr>>

    <<nobr>>
        <<widget "staminaUpdatePrint">>
            <<set _stamDec = $plrStats.stamina.pre - $plrStats.stamina.cur>>
            <<set _stamInc = $plrStats.stamina.cur - $plrStats.stamina.pre>>
            <<if $plrStats.stamina.cur < $plrStats.stamina.pre>>
                <span class="staminaDec">Your stamina decreased by _stamDec.</span>

            <<else if $plrStats.stamina.cur > $plrStats.stamina.pre>>
                <span class="staminaInc">Your stamina increased by _stamInc.</span>

            <</if>>
            <<set $plrStats.stamina.pre = $plrStats.stamina.cur>>
        <</widget>>
    <</nobr>>