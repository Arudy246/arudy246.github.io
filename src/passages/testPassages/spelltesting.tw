        </div>
    <</nobr>>\
    <hr>
    <h4>The Words, as they appear in your mind</h4>\
    <<nobr>>
        <div id='spell-box'>
            <span id='targetBox'></span>
            <span id='effectBox'></span>
            <span id='durationBox'></span>
            <span id='enhancementBox'></span>
        </div>
    <</nobr>>
    <div class='text-center'>
        <<button 'Speak the Words'>>
            <<castSpell _target _duration _effect _enhancement>>
        <</button>>
    </div>

:: Spell_Words_Widgets [widget]
    /* castSpell 'target' & 'duration' &'effect' &| 'enhancement' */
    <<widget 'castSpell'>>
        <<if _args[0] && _args[1] && _args[2] && _args[3]>>
            <<run console.log('-----castSpell Info-----')>>

            <<set _target = _args[0]>>
            <<set _duration = _args[1]>>
            <<set _effect = _args[2]>>
            <<set _enhancement = _args[3]>>
            <<set $spellCastVar.spellDiscipline = $spellWords.effect[_effect].discipline>>
            <<set $spellCastVar.spellCost = 
                $spellWords.target[_target].costMult *
                ($spellWords.effect[_effect].costMult - ($plr.disciplines[$spellCastVar.spellDiscipline].level * 0.1)) *
                $spellWords.duration[_duration].costMult *
                $spellWords.enhancement[_enhancement].costMult
            >>

            <<if $spellCastVar.spellCost <= $plr.stats.stamina.cur && $spellCastVar.spellCost <= $plr.stats.focus.cur>>
                <<run $spellWords.effect[_effect].onCast()>>
                <<set $plr.disciplines[$spellCastVar.spellDiscipline].level += $spellCastVar.spellCost * 0.2>>
                <<set $plr.stats.stamina.cur -= $spellCastVar.spellCost>>

                <<removeclass '#spell-result'>>
                <<addclass '#spell-result' 'green'>>
                <<replace '#spell-result'>>I successfully cast my spell!<</replace>>

            <<elseif $spellCastVar.spellCost > $plr.stats.stamina.cur>>
                <<removeclass '#spell-result'>>
                <<addclass '#spell-result' 'red'>>
                <<replace '#spell-result'>>I am too tired to cast the spell I want to.<</replace>>

            <<elseif $spellCastVar.spellCost > $plr.stats.focus.cur>>
                <<removeclass '#spell-result'>>
                <<addclass '#spell-result' 'red'>>
                <<replace '#spell-result'>>I do not have the mental focus required to cast a spell of this power.<</replace>>

            <</if>>

            <<run Stamina($plr.stats.stamina.cur, $plr.stats.stamina.max, "staminaBar", true)>>
            <<run Life($plr.stats.life.cur, $plr.stats.life.max, "lifeBar", true)>>
            <<run FocusStat($plr.stats.focus.cur, $plr.stats.focus.max, "focusBar", true)>>
            <<run Sanity($plr.stats.sanity.cur, $plr.stats.sanity.max, "sanityBar", true)>>

            <<run console.log('---End of castSpell Info---')>>

        <<else>>
            <<removeclass '#spell-result'>>
            <<addclass '#spell-result' 'purple'>>
            <<replace '#spell-result'>>Half-baked spells are guaranteed to go spectacularly wrong... I should complete choice of Words.<</replace>>
        <</if>>
    <</widget>>

:: Spells_Words_List [init]

    <<set $spellCastVar = {
        spellTarget: '',
        spellDuration: '',
        spellEffect: '',
        spellEnhancement: '',
        spellCost: 0,
        spellDiscipline: ''
    }>>

    <<set $eqResult = 0>>
    <<set $targetCost = 1>>
    <<set $typeCost = 1>>
    <<set $durationCost = 0.5>>
    <<set $effectCost = 1>>
    <<set $discLvl = 15>>
    <<set $strCost = 3>>

    <<set $spellWords = {
        target: {
            self: {
                latin: 'Ego',
                description: 'Selects you as the focus of the spell.',
                unlocked: false,
                costMult: 0.5,
                onCast: function() {
                    let x = state.getVar('$plr');
                    state.setVar('$spellCastVar.spellTarget', x);
                }
            },
            other: {
                latin: 'Alius',
                description: 'Selects a nearby person or creature as the focus of the spell.',
                unlocked: false,
                costMult: 1,
                onCast: function() {
                    let x = state.getVar('$npcs.janessa');
                    state.setVar('$spellCastVar.spellTarget', x);
                }
            },
            room: {
                latin: 'Praesto',
                description: 'Selects the room you are in as the focus of the spell.',
                unlocked: false,
                costMult: 1.5,
                onCast: function() {
                    return 1
                }
            },
            outdoors: {
                latin: 'Circa',
                description: 'Selects a large outdoor area (i.e. a courtyard, tree grove, or park) as the focus of the spell.',
                unlocked: false,
                costMult: 1.5,
                onCast: function() {
                    return 1
                }
            },
            item: {
                latin: 'Item',
                description: 'Selects an item as the focus of the spell.',
                unlocked: false,
                costMult: 1,
                onCast: function() {
                    return 1
                }
            }
        },
        duration: {
            immediate: {
                latin: 'Nunc',
                description: 'The spell effect is applied immediately.',
                costMult: 1,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 0);
                }
            },
            minute: {
                latin: 'Mox',
                description: 'The spell applies the affect now and for a few minutes.',
                costMult: 5,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 10);
                }
            },
            hour: {
                latin: 'Postea',
                description: 'The spell applies the effect now and for about an hour.',
                costMult: 10,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 60);
                }
            },
            day: {
                latin: 'Hodie',
                description: 'The spell applies the effect for about a day.',
                costMult: 20,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 1440);
                }
            },
            week: {
                latin: 'Septimana',
                description: 'The spell applies the effect for around one week',
                costMult: 40,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 10080);
                }
            },
            month: {
                latin: 'Mensis',
                description: 'The spell applies the effect for a whole month.',
                costMult: 60,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 40320);
                }
            }
        },
        effect: {
            damage: {
                latin: 'Damnum',
                description: 'Uses the destructive aspect of elemental magic to cause physical injuries.',
                costMult: 1,
                unlocked: false,
                discipline: 'elemental',
                onCast: function() {
                    let curLife = state.getVar('$spellCastVar.spellTarget.stats.life.cur');
                    let maxLife = state.getVar('$spellCastVar.spellTarget.stats.life.max');
                    let mult = state.getVar('$spellCastVar.spellEnhancement');

                    if (curLife > 0) {
                        let r = curLife - (1 * mult);
                        state.setVar('$spellCastVar.spellTarget.stats.life.cur', r);
                    }
                }
            },
            heal: {
                latin: 'Vulnus',
                description: 'Renews the lifeforce and heals the surface wounds of living beings.',
                costMult: 1,
                unlocked: false,
                discipline: 'restoration',
                onCast: function() {
                    let curLife = state.getVar('$spellCastVar.spellTarget.stats.life.cur');
                    let maxLife = state.getVar('$spellCastVar.spellTarget.stats.life.max');
                    let mult = state.getVar('$spellCastVar.spellEnhancement');
                    
                    if (curLife < maxLife) {
                        let r = curLife + (1 * mult);
                        state.setVar('$spellCastVar.spellTarget.stats.life.cur', r);
                    }
                }
            },
            calm: {
                latin: 'Tranquillitas',
                description: 'Eases the mind, restoring a small amount of sanity.',
                costMult: 1.5,
                unlocked: false,
                discipline: 'restoration',
                onCast: function() {
                    let x = state.getVar('$spellCastVar.spellTarget.stats.sanity.cur');
                    state.setVar('$spellCastVar.spellEffect', x);
                }
            }
        },
        enhancement: {
            none: {
                latin: 'Nullus',
                description: 'Choose to not increase the power of your spell.',
                costMult: 1,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 1);
                }
            },
            enhance1: {
                latin: 'Augere',
                description: 'Add a little more of your energy into the spell.',
                costMult: 2,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 2);
                }
            },
            enhance2: {
                latin: 'Augmento',
                description: 'Add a decent amount of energy into the spell.',
                costMult: 5,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 3)
                }
            },
            enhance3: {
                latin: 'Amplius',
                description: 'Pour your energy into the spell!',
                costMult: 15,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 4)
                }
            },
            enhance4: {
                latin: 'Vastus',
                description: 'Give the spell almost everything you have!!',
                costMult: 30,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 5)
                }
            },
            enhance5: {
                latin: 'Immanis',
                description: 'You will not be contained!!!',
                costMult: 60,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 7)
                }
            }
        }
    }>>
