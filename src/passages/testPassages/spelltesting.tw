:: Testing_Spells
    <<speech plr>>This is the spell testing grounds. Good luck dude...<</speech>>

    <hr>
    <h3>Experiment Area</h3>\
    <<print 'nothing'>>
    <hr>
    
    targetCost:     <<numberbox '$targetCost' $targetCost>>
    typeCost:       <<numberbox '$typeCost' $typeCost>>
    durationCost:   <<numberbox '$durationCost' $durationCost>>
    effectCost:     <<numberbox '$effectCost' $effectCost>>
    strCost:        <<numberbox '$strCost' $strCost>>
    discLvl:        <<numberbox '$discLvl' $discLvl>>

    Equation Result: <<print $eqResult.toFixed(2)>>

    <<button [[Process Cost Equation | Testing_Spells]]>>
        <<set $eqResult = $targetCost * $typeCost * $durationCost * $strCost * ($effectCost / ($discLvl * 0.4))>>
    <</button>>
    <hr>

    <h3>Spell Buttons</h3>\
    <<button 'Cast Self Damage Spell'>>
        <<castSpell 'self' 'direct' 'immediate' 'damage'>>
    <</button>>
    <hr>

:: Spell_Words_Widgets [widget]

    /* castSpell 'target' 'type' 'duration' 'effect' 'enhancement' */
    <<widget 'castSpell'>>

        <<set _target = $spellWords.target[_args[0]].onCast()>>
        <<set _type = $spellWords.type[_args[1]].onCast()>>
        <<set _duration = $spellWords.duration[_args[2]].onCast()>>
        <<set _effect = $spellWords.effect[_args[3]].onCast()>>
        <<if _args[4]>>
            <<set _enhance = $spellWords.enhancement[_args[4]].onCast()>>
        <<else>>
            <<set _enhance = 1>>
        <</if>>

        <<run console.log('_target: ' + _target)>>

    <</widget>>

    <<widget 'tDamageSpell'>>

        <<set _target = $spellWords.target.self.onCast()>>
        /* <<set _type = $spellWords.type.direct.onCast()>>
        <<set _duration = $spellWords.duration.immediate.onCast()>> */
        <<set _effect = $spellWords.effect.damage.onCast()>>
        <<set _enhance = $spellWords.enhancement.enhance.onCast()>>

        <<run Life($plrStats.life.cur, $plrStats.life.max, "lifeBar", true)>>
        <<run console.log('tDamageSpell: ' + _runspell)>>


    <</widget>>

:: Spells_Words_List [init]
    <<set $spellWords = {
        target: {
            self: {
                latin: 'Ego',
                description: 'Selects you as the focus of the spell.',
                unlocked: false,
                costMulti: 0.5,
                onCast: function() {
                    return '$plrStats';
                }
            },
            other: {
                latin: 'Alius',
                description: 'Selects a nearby person or creature as the focus of the spell.',
                unlocked: false
            },
            room: {
                latin: 'Praesto',
                description: 'Selects the room you are in as the focus of the spell.',
                unlocked: false
            },
            wide: {
                latin: 'Circa',
                description: 'Selects a wide area (i.e. a residence or courtyard) as the focus of the spell.',
                unlocked: false
            },
            item: {
                latin: 'Item',
                description: 'Selects an item as the focus of the spell.',
                unlocked: false
            }
        },
        type: {
            direct: {
                latin: 'Focus',
                description: 'The spell only directly affects the initial target.',
                costMult: 1,
                unlocked: false,
                onCast: function() {
                    return
                }
            },
            aura: {
                latin: 'Aura',
                description: 'The spell surrounds the initial target, but affects it and the surrounding area.',
                unlocked: false
            },
            enchant: {
                latin: 'Admagicae',
                description: 'Mostly used to add an effect to an item.',
                unlocked: false
            }
        },
        duration: {
            immediate: {
                latin: 'Nunc',
                description: 'The spell effect is applied immediately.',
                costMult: 1,
                unlocked: false,
                onCast: function() {
                    return
                }
            },
            minute: {
                latin: 'Mox',
                description: 'The spell applies the affect now and for a few minutes.',
                unlocked: false
            },
            hour: {
                latin: 'Postea',
                description: 'The spell applies the effect now and for about an hour.',
                unlocked: false
            },
            day: {
                latin: 'Hodie',
                description: 'The spell applies the effect now and for about a day.',
                unlocked: false
            },
            week: {
                latin: 'Septimana',
                description: 'The spell applies the effect now and for around one week',
                unlocked: false
            },
            month: {
                latin: 'Mensis',
                description: 'The spell applies the effect now and for a whole month.',
                unlocked: false
            }
        },
        effect: {
            damage: {
                latin: 'Damnum',
                description: 'Uses the destructive abilities of a given element type causing injuries.',
                costMult: 1,
                unlocked: false,
                onCast: function() {
                    return '.life.cur';
                }
            },
            heal: {
                latin: 'Vulnus',
                description: 'Renews the lifeforce and heals the surface wounds of living beings.',
                unlocked: false
            }
        },
        enhancement: {
            enhance: {
                latin: 'Augere',
                description: 'Pour more of your energy into the spell.',
                unlocked: false,
                onCast: function() {
                    return 1
                }
            },
            delay: {
                latin: 'Moratus',
                description: 'Delays the effect of the spell for a chosen period of time.',
                unlocked: false
            }
        }
    }>>
        <<set $eqResult = 0>>
        <<set $targetCost = 1>>
        <<set $typeCost = 1>>
        <<set $durationCost = 0.5>>
        <<set $effectCost = 1>>
        <<set $discLvl = 15>>
        <<set $strCost = 3>>

        strength: {
            1: 3
            2: 4
            3: 9
            4: 16
            5: 25
        }