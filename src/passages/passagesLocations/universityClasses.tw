:: Floor1_Class_Room107
    <img class='scene' src='img/locations/floor1_class_room107.jpg'>
    <<Updates noClass>>
    <<nobr>>
        <<if $dateTime.hour < 10>>
            <<speech jonathan>>
                Class starts at 10:00, might you have somewhere else to be?
            <</speech>>
            <br>
            <<nobr>>
                <div class='passage-links-grid-1'>
                    <<button [[Go Back | University_Hall_Classes]]>>
                        <<calcTime 0 5>>
                    <</button>>
                </div>
            <</nobr>>
            <<else>>
                <<speech jonathan>>
                    Hello everyone, and welcome $plr.name.formal to Arcane Disciplines 101.
                <</speech>>
        <</if>>
    <</nobr>>

:: Floor1_Class_Room107_Closed
    <img class='scene' src='img/locations/closed_wood_door.jpg'>
    <<Updates>>
    <<speech plr>>
        The door is locked.
    <</speech>>
    <<nobr>>
        <div class='passage-links-grid-1'>
            <<button [[Go Back | University_Hall_Classes]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

:: Hall_Floor2
    <img class='scene' src='img/locations/hall_floor2.jpg'>
    <<Updates>>
    <<speech plr>>
        This is the second floor of the classroom wing.
    <</speech>>
    <<nobr>>
        <div class='passage-links-grid-1'>
            <<TimeCheck 1000 1200 weekdays>>
                <<button [[Room 205 | Floor2_Class_Room205]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>
            <<TimeCheck 1000 1200 cycleNoWeekend>>
                <<button [[Room 205 (locked) | Floor2_Class_Room205_Closed]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>

            <<button [[First Floor Hall | University_Hall_Classes]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>
