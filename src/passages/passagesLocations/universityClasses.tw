:: Gymnasium
    <img class='scene' src='img/locations/gymnasium.jpg'>
    <<Updates>>

:: Floor1_Class_Room105
    <img class='scene' src='img/locations/floor1_class_room105.jpg'>
    <<Updates noClass>>
    <<nobr>>
        <<if $dateTime.hour < 8>>
            <<speech elliot>>
                We start at 08:00 $plr.name.formal, which makes you a little early. Feel free to wait around for class to start.
            <</speech>>
            <br>
            <<nobr>>
                <div class='passage-links-grid-1'>
                    <<button [[Wait | Floor1_Class_Room105]]>>
                        <<SetTime 8>>
                    <</button>>
                    <<button [[Go Back | University_Hall_Classes]]>>
                        <<calcTime 0 5>>
                    <</button>>
                </div>
            <</nobr>>

            <<else>>
                <<ClassLectures arcanearts101>>
        <</if>>
    <</nobr>>

:: Floor1_Class_Room105_Closed
    <img class='scene' src='img/locations/closed_wood_door.jpg'>
    <<Updates>>
    <<speech plr>>
        The door is locked.
    <</speech>>
    <<nobr>>
        <div class='passage-links-grid-1'>
            <<button [[Go Back | University_Hall_Classes]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>
    

