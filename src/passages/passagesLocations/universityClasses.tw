:: Gymnasium
    <<nobr>>
        <<passagehead locations gymnasium>>

        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Go Back | University_Hall_Classes]]>>
                <<calcTime 5 0>>
            <</button>>
        </div>
    <</nobr>>

:: Floor1_Class_Room105
    <<nobr>>
        <<passagehead locations floor1_class_room105 noclass>>
            <<if $dateTime.hour < 8>>
                <<speech elliot>>
                    We start at 08:00 $plr.name.formal, which makes you a little early. Feel free to wait around for class to start.
                <</speech>>
                <br>
                <<nobr>>
                    <div class='passage-links-grid-2'>
                        <<button [[Wait | Floor1_Class_Room105]]>>
                            <<SetTime 8>>
                        <</button>>
                        <<button [[Go Back | University_Hall_Classes]]>>
                            <<calcTime 0 5>>
                        <</button>>
                    </div>
                <</nobr>>

                <<else>>
                    <<ClassLectures arcanearts101>>
            <</if>>
        <</passagehead>>
    <</nobr>>

:: Floor1_Class_Room105_Closed
    <<nobr>>
        <<passagehead locations closed_wood_door>>
            <<speech plr thought>>
                Looks like the door is locked.
            <</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Go Back | University_Hall_Classes]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>
    

:: Floor1_Class_Room106
    <<nobr>>
        <<passagehead locations floor1_class_room106 noclass>>
            <<nobr>>
                <<if $dateTime.hour < 9>>
                    <<speech juliette>>
                        We start at 09:00 $plr.name.formal, but you know what they say, early bird eats the mouse! Yes, I know, that isn't quite the right saying. Anyways, feel free to take a seat if you have nowhere else to go and class will start soon!
                    <</speech>>
                    <br>
                    <<nobr>>
                        <div class='passage-links-grid-2'>
                            <<button [[Sit down | Floor1_Class_Room106]]>>
                                <<SetTime 9 1>>
                            <</button>>
                            <<button [[Go Back | University_Hall_Classes]]>>
                                <<calcTime 0 5>>
                            <</button>>
                        </div>
                    <</nobr>>

                    <<else>>
                        <<ClassLectures conservation101>>
                <</if>>
            <</nobr>>
        <</passagehead>>
    <</nobr>>
    
:: Floor1_Class_Room106_Closed
    <<nobr>>
        <<passagehead locations closed_wood_door>>
            <<speech plr thought>>
                Looks like the door is locked.
            <</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Go Back | University_Hall_Classes]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

:: Floor1_Class_Room107
    <<nobr>>
        <<passagehead locations floor1_class_room107 noclass>>
            <<nobr>>
                <<if $dateTime.hour < 10>>
                    <<speech jonathan>>
                        Class starts at 10:00, might you have somewhere else to be? If not, just take a seat and try to be quiet.
                    <</speech>>
                    <br>
                    <<nobr>>
                        <div class='passage-links-grid-2'>
                            <<button [[Sit down | Floor1_Class_Room107]]>>
                                <<SetTime 10 1>>
                            <</button>>
                            <<button [[Go Back | University_Hall_Classes]]>>
                                <<calcTime 0 5>>
                            <</button>>
                        </div>
                    <</nobr>>
                    <<else>>
                        <<ClassLectures arcanedisciplines101>>
                <</if>>
            <</nobr>>
        <</passagehead>>
    <</nobr>>

:: Floor1_Class_Room107_Closed
    <<nobr>>
        <<passagehead locations closed_wood_door>>
            <<speech plr thought>>
                Looks like the door is locked.
            <</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Go Back | University_Hall_Classes]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

:: Hall_Floor2
    <<nobr>>
        <<passagehead locations hall_floor2>>
            <<speech plr thought>>
                This is the second floor of the classroom wing.
            <</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<TimeCheck '1000' '1200' weekdays>>
                <<button [[Room 205 | Floor2_Class_Room205]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>
            <<TimeCheck '1000' '1200' cycleNoWeekend>>
                <<button [[Room 205 (locked) | Floor2_Class_Room205_Closed]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>

            <<button [[First Floor Hall | University_Hall_Classes]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>
:: Floor2_Class_Room205
    <<nobr>>
        <<passagehead locations floor2_class_room205 noclass>>
            <<nobr>>
                <<if $dateTime.hour < 11>>
                    <<speech celeste>>
                        I won't start until 11:00, come back then please. Or I suppose you could find a seat and wait awhile. Your choice!
                    <</speech>>
                    <br>
                    <<nobr>>
                        <div class='passage-links-grid-2'>
                            <<button [[Sit down | Floor2_Class_Room205]]>>
                                <<SetTime 11 1>>
                            <</button>>
                            <<button [[Go Back | Hall_Floor2]]>>
                                <<calcTime 0 5>>
                            <</button>>
                        </div>
                    <</nobr>>
                    <<else>>
                        <<ClassLectures arcanelaw101>>
                <</if>>
            <</nobr>>
        <</passagehead>>
    <</nobr>>

:: Floor2_Class_Room205_Closed
    <<nobr>>
        <<passagehead locations closed_wood_door>>
            <<speech plr thought>>
                Looks like the door is locked.
            <</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Go Back | Hall_Floor2]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>