:: Residence_Starr_Courtyard[outdoors]
    <<nobr>>
        <<passagehead 'locations' 'residence_starr_courtyard'>>
            <<spawnevent location Residence_Starr_Courtyard_Random allowrandom '0000' '2400'>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <<if $eventVar.inCombat == false>>
            <div class='passage-links-grid-2'>
                <<button[[Enter the Starr Residence | Residence_Starr_EntryHall]]>>
                    <<calcTime 0 5>>
                <</button>>
                <<button [[University Main Road | University_MainRoad]]>>
                    <<calcTime 0 5>>
                <</button>>
            </div>
        <</if>>
        <<if $eventVar.inCombat == true && $plr.stats.stamina.cur <= 1>>
            <<button 'Try to catch your breath'>>
                <<setStats plr stamina 1>>
                <<goto 'Spell_Combat'>>
            <</button>>
        <</if>>
    <</nobr>>

:: Residence_Starr_BanquetHall[room]
    <<nobr>>
        <<passagehead 'locations' 'residence_starr_banquethall'>>
            <<if $roomVars.Residence_Starr_BanquetHall.clean >= 20>>
                <<speech plr>>
                    The banquet hall is impressive, or at least it would be, if someone had used a broom on it in the last century. Or two. It's <<roomComments 'clean'>>
                <</speech>>
            <<elseif $roomVars.Residence_Starr_BanquetHall.clean >= 10 && $roomVars.Residence_Starr_BanquetHall.clean < 20>>
                <<speech plr>>
                    This is quite the hall, although it's a little dirty and could use some attention. It's <<roomComments 'clean'>>
                <</speech>>
            <<elseif $roomVars.Residence_Starr_BanquetHall.clean <= 10 >>
                <<speech plr>>
                    Now this a good looking banquet hall, orderly and polished! It's <<roomComments 'clean'>>
                <</speech>>
            <</if>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Entry Hall | Residence_Starr_EntryHall]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

:: Residence_Starr_Bathroom[room bathroom]
    <<nobr>>
        <<passagehead 'locations' 'residence_starr_bathroom'>>
            <<speech plr thought>>It is definitely a bathroom. Judging by the state of it, it's <<roomComments 'clean'>><</speech>>
            <<spawnevent npc Janessa_Random allowrandom '0500' '0600'>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Bedroom Hallway | Residence_Starr_BedroomHall]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

:: Residence_Starr_EntryHall
    <<nobr>>
        <<passagehead locations residence_starr_entryhall>>
            <<speech plr thought>>
                This is the entryway into the rest of the residence.                
            <</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Kitchen | Residence_Starr_Kitchen]]>>
                <<calcTime 0 5>>
            <</button>>
            <<button [[Banquet Room | Residence_Starr_BanquetHall]]>>
                <<calcTime 0 5>>
            <</button>>
            <<button [[Bedroom Hallway | Residence_Starr_BedroomHall]]>>
                <<calcTime 0 5>>
            <</button>>
            <<button [[Exit Residence | Residence_Starr_Courtyard]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

:: Residence_Starr_BedroomHall[room]
    <<nobr>>
        <<passagehead 'locations' 'residence_starr_bedroomhall'>>
            <<speech plr thought>>Looks like a bedroom hallway.<</speech>>
            <br>
            <<spawnevent npc Janessa_CourseOverview forbidrandom '0000' '2400'>>
            <<spawnevent npc Janessa_FirstClass forbidrandom '0600' '0800'>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Your Room | Residence_Starr_PlayerRoom]]>>
                <<calcTime 0 5>>
            <</button>>
            <<button [[Bathroom | Residence_Starr_Bathroom]]>>
                <<calcTime 0 5>>
            <</button>>
            <<button [[Janessa's Room | Residence_Starr_JanessaRoom]]>>
                <<calcTime 0 5>>
            <</button>>
            <<button [[Entry Hall | Residence_Starr_EntryHall]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

:: Residence_Starr_JanessaRoom[room]
    <<nobr>>
        <<passagehead locations residence_starr_janessaroom>>
            <<speech plr thought>>$npcs.janessa.name.firstName said to stay out. For now, I should do just that.<</speech>>
            <<spawnevent npc Janessa_Random allowrandom '1900' '2300'>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Bedroom Hallway | Residence_Starr_BedroomHall]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

:: Residence_Starr_Kitchen[room]
    <<nobr>>
        <<passagehead locations residence_starr_kitchen>>
            <<speech plr thought>>She was right, this place hasn't been used in years. As far as it's condition is concerned, it's <<roomComments 'clean'>><</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Entry Hall | Residence_Starr_EntryHall]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

:: Residence_Starr_PlayerRoom[room playerHome]
    <<nobr>>
        <<passagehead locations residence_starr_playerroom>>
            <<speech plr>>I'm in my room. Glancing at the state of the place, it's <<roomComments 'clean'>> The floor is of <<roomComments 'floor'>> quality. I see my <<roomComments 'chair'>> chair and <<roomComments 'desk'>> desk in the corner. On the far wall is my <<roomComments 'bed'>> bed. The room is <<roomComments 'light'>> lit.<</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <<if $roomVars.Residence_Starr_PlayerRoom.bookspell.cur != $roomVars.Residence_Starr_PlayerRoom.bookspell.max || $roomVars.Residence_Starr_PlayerRoom.bookmisc.cur != $roomVars.Residence_Starr_PlayerRoom.bookmisc.cur>>
            <<speech plr>>For starters, I should probably take a look around and see if there is anything useful or interesting here.<</speech>>
        <</if>>

        <<if $spellWords.effect.clean.unlocked != true && $roomVars.Residence_Starr_PlayerRoom.bookspell.cur == $roomVars.Residence_Starr_PlayerRoom.bookspell.max>>
            <<speech plr>>I found a spell book and it calls to me. I really should read all of it. I already placed it in my <b>Inventory</b>.<</speech>>
        <</if>>
        <<if $bookSpell.spellsBasic.pagesRead == $bookSpell.spellsBasic.pagesTotal && $spellWords.effect.clean.timesCast < 1>>
            <<speech plr>>After finishing $bookSpell.spellsBasic.title, I think I know how to clean this place up. And a cleaning spell is exactly what the doctor ordered!<</speech>>
        <</if>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Search your room | Residence_Starr_PlayerRoom_Searching]]>><</button>>

            <<nobr>>
                <<if not hasVisited("Residence_Starr_PlayerRoom_Sleeping")>>
                    <<button [[Try to sleep | Residence_Starr_PlayerRoom_Sleeping]]>>
                        <<calcTime 30 5>>
                    <</button>>
                    <<else>>
                    <<button "Try to sleep">>
                        <<run
                            Dialog.setup("Pointless Endeavor");
                            Dialog.append("Sleep seems impossible, trying again would just be a waste of time.");
                            Dialog.open();
                        >>
                    <</button>>
                <</if>>
            <</nobr>>
            <<button [[Relax (1hr) | Residence_Starr_PlayerRoom_Resting]]>>
                <<calcTime 60 0 false>>
                <<setStats 'plr' 'stamina' 2>>
                <<setStats 'plr' 'sanity' 0.5>>
                <<setStats 'plr' 'focus' 0.1>>
                <<setStats plr life 0.2>>
            <</button>>
            <<button [[Relax (4hr) | Residence_Starr_PlayerRoom_Resting]]>>
                <<calcTime 240 0 false>>
                <<setStats 'plr' 'stamina' 8>>
                <<setStats 'plr' 'sanity' 2>>
                <<setStats 'plr' 'focus' 0.3>>
                <<setStats plr life 0.8>>
            <</button>>
            <<button 'Exit Room'>>
                <<if $spellWords.effect.clean.unlocked == true>>
                    <<goto Residence_Starr_BedroomHall>>
                    <<calcTime 0 5>>
                    <<else>>
                        <<if $roomVars.Residence_Starr_PlayerRoom.bookspell.cur == 0>>
                            <<run
                                Dialog.setup('Hold on a Second');
                                Dialog.append('I should probably search through my room first.');
                                Dialog.open()
                            >>
                            <<else>>
                                <<run
                                Dialog.setup('Hold on a Second');
                                Dialog.append('I should probably read that book I found.');
                                Dialog.open()
                            >>
                        <</if>>
                <</if>>
            <</button>>
        </div>
    <</nobr>>

:: Residence_Starr_PlayerRoom_Searching[minorEvent]
    <<nobr>>
        <<passagehead locations residence_starr_searchclutter>>
            <<nobr>>
                <<if visited() == 2>>
                    <<searchForItem 'Residence_Starr_PlayerRoom' 'bookmisc' 'mapSchool' 30>>
                <</if>>
                <<if visited() == 1>>
                    <<searchForItem 'Residence_Starr_PlayerRoom' 'bookspell' 'spellsBasic' 30>>
                    <<set $unlockVar.userInterface.inventory = true>>
                <</if>>
                <<if visited() > 2>>
                    <<speech plr thought>>This place is picked clean of anything interesting or useful.<</speech>>
                <</if>>
            <</nobr>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Look back at your room | Residence_Starr_PlayerRoom]]>>
            <</button>>
        </div>
    <</nobr>>

:: Residence_Starr_PlayerRoom_Sleeping
    <<nobr>>
        <<passagehead locations residence_starr_resting>>
            <<speech plr thought>>Try as I might, I simply cannot sleep. Letting my mind go blank, counting sheep, nothing is working! Nevermind on this idea I guess.<</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Stand up | Residence_Starr_PlayerRoom]]>>
            <</button>>
        </div>
    <</nobr>>
:: Residence_Starr_PlayerRoom_Resting
    <<nobr>>
        <<passagehead locations residence_starr_resting>>
            <<speech plr thought>>I feel a bit more rested. And this <<roomComments 'bed'>> bed...<</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[Stand up | Residence_Starr_PlayerRoom]]>><</button>>
        </div>
    <</nobr>>

