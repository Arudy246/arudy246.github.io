    <<speech plr>>
        Only a little eerie, at least it's not an actual dungeon.
    <</speech>>
    <<nobr>>
        <div class='passage-links-grid-1'>
            <<TimeCheck 1100 1300 weekdays>>
                <<button [[Room B-3 | Basement_Class_RoomB3]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>
            <<TimeCheck 1100 1300 cycleNoWeekend>>
                <<button [[Room B-3 (locked) | Basement_Class_RoomB3_Closed]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>

            <<button [[Entry Hall | University_Entrance]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>