:: University_MainRoad
    <<nobr>>
        <<passagehead locations university_mainroad>>
            <<speech plr thought>>
                Well this is quaint.
            <</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[University Courtyard | University_MainCourtyard]]>>
            <<calcTime 10 5>>
            <</button>>
            <<button [[Main Gate | University_Gate]]>>
                <<calcTime 10 5>>
            <</button>>
            <<button [[Starr Residence Courtyard | Residence_Starr_Courtyard]]>>
                <<calcTime 10 5>>
            <</button>>
        </div>
    <</nobr>>

:: University_MainCourtyard
    <<nobr>>
        <<passagehead locations university_maincourtyard>>
            <<speech plr thought>>
                Yup, that's a magical looking courtyard.
            <</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[University Entry Hall | University_Entrance]]>>
                <<calcTime 5 5>>
            <</button>>
            <<button [[University Road | University_MainRoad]]>>
                <<calcTime 5 5>>
            <</button>>
        </div>
    <</nobr>>

:: University_Gate
    <<nobr>>
        <<passagehead locations university_gate>>
            <<speech plr thought>>
                Woh, now that's a gate. Sadly, it looks very much locked. And the air seems to shimmer along the outerwall. An illusion? Or maybe a shield of some sort. Not sure yet...
            <</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<button [[University Main Road | University_MainRoad]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

:: University_Entrance
    <<nobr>>
        <<passagehead locations university_entrance>>
