:: University_Hall_Classes
    <<nobr>>
        <<passagehead locations university_hall_classes>>
            <<speech plr thought>>
                Thats a lot of classrooms!
            <</speech>>
        <</passagehead>>
    <</nobr>>
    <<nobr>>
        <div class='passage-links-grid-2'>
            <<TimeCheck '0700' '0900' weekdays>>
                <<button [[Room 105 | Floor1_Class_Room105]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>
            <<TimeCheck '0700' '0900' cycleNoWeekend>>
                <<button [[Room 105 (locked) | Floor1_Class_Room105_Closed]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>

            <<TimeCheck '0800' '1000' weekdays>>
                <<button [[Room 106 | Floor1_Class_Room106]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>
            <<TimeCheck '0800' '1000' cycleNoWeekend>>
                <<button [[Room 106 (locked) | Floor1_Class_Room106_Closed]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>

            <<TimeCheck '0900' '1100' weekdays>>
                <<button [[Room 107 | Floor1_Class_Room107]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>
            <<TimeCheck '0900' '1100' cycleNoWeekend>>
                <<button [[Room 107 (locked) | Floor1_Class_Room107_Closed]]>>
                    <<calcTime 0 5>>
                <</button>>
            <</TimeCheck>>

            <<button [[Second Floor | Hall_Floor2]]>>
                <<calcTime 0 5>>
            <</button>>
            <<button [[Gymnasium | Gymnasium]]>>
                <<calcTime 0 5>>
            <</button>>
            <<button [[Entry Hall | University_Entrance]]>>
                <<calcTime 0 5>>
            <</button>>
        </div>
    <</nobr>>

