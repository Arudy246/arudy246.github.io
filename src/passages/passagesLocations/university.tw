            <<button [[Classrooms | University_Hall_Classes]]>>
                <<calcTime 5 5>>
            <</button>>
            <<button [[Shops | University_Hall_Shops]]>>
                <<calcTime 5 5>>
            <</button>>
            <<button [[Labratories | University_Hall_Labs]]>>
                <<calcTime 5 5>>
            <</button>>
            <<button [[Artificers | University_Hall_Crafts]]>>
                <<calcTime 5 5>>
            <</button>>
            <<button [[Basement | University_Hall_Basement]]>>
                <<calcTime 5 5>>
            <</button>>
            <<button [[Admin Wing | University_Hall_Admin]]>>
                <<calcTime 5 5>>
            <</button>>
            <<button [[Librarium | University_Librarium]]>>
                <<calcTime 5 5>>
            <</button>>
            <<button [[Leave the building | University_MainCourtyard]]>>
                <<calcTime 5 5>>
            <</button>>
        </div>
    <</nobr>>
