:: Spells

    <<nobr>>
        <<if $spellDetails.illusion.floatingflame.unlocked == true>>
            <<hovertip $spellDetails.illusion.floatingflame.description>>
                <<link "Floating Flame">>
                    <<set $plrRoom.lights.none = false>>
                    <<set $plrRoom.lights.trash = true>>
                    <<set $plrDisciplines.illusion.level += 1>>
                    <<run
                        Dialog.setup("Spell Cast");
                        Dialog.append("You just case the Floating Flame spell.");
                        Dialog.open();
                    >>
                <</link>>
            <</hovertip>>
        <</if>>
    <</nobr>>