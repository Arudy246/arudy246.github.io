:: StoryCaption
    @@#timeplusdate;<<calcTime '' '' '' 'nodebug'>>@@\
    <hr>
    <<nobr>>
        <<if $plr.name.firstName != "" && $plr.name.firstName != "First">>
            <u>My Name: $plr.name.firstName $plr.name.lastName</u>
            <hr>
        <</if>>
    <</nobr>>\

:: StoryBanner
    <img class="banner" src='img/logo.png'/>

:: StoryMenu
    <<if $devMode == true>>
        <<link "!Dev Wand">>
            <<run
                Dialog.setup("Dev Wand", "dev wand");
                Dialog.wiki(Story.get("DevWand").processText());
                Dialog.open();
            >>
        <</link>>
        <<link "!Dev Char Info">>
            <<run
                Dialog.setup("Character Info", "char-info");
                Dialog.wiki(Story.get("Character Info").processText());
                Dialog.open();
            >>
        <</link>>
    <</if>>

    <<if $unlockVar.userInterface.stats == true>>
        <<link [[Your Status]]>><</link>>
    <</if>>

    <<if $unlockVar.userInterface.locations == true>>
        <<link "Locations">>
            <<run 
                Dialog.setup("Locations", "locations");
                Dialog.wiki(Story.get("Locations").text);
                Dialog.open();
            >>
        <</link>>
    <</if>>

    <<if $unlockVar.userInterface.inventory == true>>
        <<link "Inventory">>
            <<run 
                Dialog.setup("Inventory", "inventory"); 
                Dialog.wiki(Story.get("Inventory").text); 
                Dialog.open();
            >>
        <</link>>
    <</if>>

    <<if $unlockVar.userInterface.schedule == true >>
        <<link "Classes">>
            <<run 
                Dialog.setup("Class Schedule", "schedule"); 
                Dialog.wiki(Story.get("Schedule").text); 
                Dialog.open();
            >>
        <</link>>
    <</if>>

:: Character Info
    <<nobr>>
        <div class='w3-bar'>
            <button class='w3-bar-item w3-button w3-border w3-round-xxlarge w3-border-dark-grey w3-black' onclick='openTab("PlrName")'>Player Name</button>
            <button class='w3-bar-item w3-button w3-border w3-round-xxlarge w3-border-dark-grey w3-black' onclick='openTab("PlrBodyStatic")'>Player Body S</button>
            <button class='w3-bar-item w3-button w3-border w3-round-xxlarge w3-border-dark-grey w3-black' onclick='openTab("PlrBodyDynamic")'>Player Body D</button>
            <button class='w3-bar-item w3-button w3-border w3-round-xxlarge w3-border-dark-grey w3-black' onclick='openTab("PlrDisciplines")'>Player Disciplines</button>
            <button class='w3-bar-item w3-button w3-border w3-round-xxlarge w3-border-dark-grey w3-black' onclick='openTab("JanessaRelation")'>Janessa Relation</button>
            <button class='w3-bar-item w3-button w3-border w3-round-xxlarge w3-border-dark-grey w3-black' onclick='openTab("BardenRelation")'>Barden Relation</button>
            <button class='w3-bar-item w3-button w3-border w3-round-xxlarge w3-border-dark-grey w3-black' onclick='openTab("AmyRelation")'>Amy Relation</button>
        </div>
    <</nobr>>
    <<nobr>>
        <div id='PlrName' class='tabElement'>
            <<= charInfoTbl($plr.name, "plr.name")>>
        </div>
        <div id='PlrBodyStatic' class='tabElement'>
            <<= charInfoTbl($plr.body.static, "plr.body.static")>>
        </div>
        <div id='PlrBodyDynamic' class='tabElement'>
            <<= charInfoTbl($plr.body.dynamic, "plr.body.dynamic")>>
        </div>
        <div id='PlrDisciplines' class='tabElement'>
            <<= charInfoTblSub($plr.disciplines, "plr.disciplines")>>
        </div>
        <div id='JanessaRelation' class='tabElement'>
            <<= charInfoTbl($plr.relations.janessa, "Janessa Relation")>>
        </div>
        <div id='BardenRelation' class='tabElement'>
            <<= charInfoTbl($plr.relations.barden, "Barden Relation")>>
        </div>
        <div id='AmyRelation' class='tabElement'>
            <<= charInfoTbl($plr.relations.amy, "Amy Relation")>>
        </div>
    <</nobr>>

:: Schedule
    <i>If I have read about the classrooms in a certain book, I can just go straight there.</i>
