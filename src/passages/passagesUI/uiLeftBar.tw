:: Inventory [nobr]
    <h3>Currency</h3>\
    <<inv $plrCurrencies inspect>>
    <hr>
    <h3>Books</h3>\
    <<inv $plrinvbooks use inspect>>
    <hr>
    <h3>Materials</h3>\
    <<inv $plrinvmaterials use inspect>>
    <hr>
    <h3>Miscellanious</h3>\
    <<inv $plrinvmisc use inspect>>

:: Locations
    <h3>School</h3>\
    <<nobr>>
        <div class='passage-links-grid-5c'>
            <<if $unlockVar.locations.starrresidence.unlocked == true>>
                <<button [[Starr Residence | Residence_Starr_EntryHall]]>>
                    <<run Dialog.close()>>
                    <<calcTime 10>>
                <</button>>
            <</if>>
            <<if $unlockVar.locations.universityentrance.unlocked == true>>
                <<button [[University Entrance | University_Entrance]]>>
                    <<run Dialog.close()>>
                    <<calcTime 10>>
                <</button>>
            <</if>>
            <<if $unlockVar.locations.cafeteria.unlocked == true>>
                <<button [[Cafeteria | University_Shops_Cafeteria]]>>
                    <<run Dialog.close()>>
                    <<calcTime 10>>
                <</button>>
            <</if>>
            <<if $unlockVar.locations.clinic.unlocked == true>>
                <<button [[Clinic | University_Admin_Clinic]]>>
                    <<run Dialog.close()>>
                    <<calcTime 10>>
                <</button>>
            <</if>>
            
            <<if $unlockVar.locations.universityclasses.unlocked == true>>
                <<button [[University Classes | University_Hall_Classes]]>>
                    <<run Dialog.close()>>
                    <<calcTime 10>>
                <</button>>
            <</if>>
            <<if $unlockVar.locations.universityshops.unlocked == true>>
                <<button [[University Shops | University_Hall_Shops]]>>
                    <<run Dialog.close()>>
                    <<calcTime 10>>
                <</button>>
            <</if>>
            <<if $unlockVar.locations.professoroffices.unlocked == true>>
                <<button [[Professor Wing | University_Admin_ProfessorHall]]>>
                    <<run Dialog.close()>>
                    <<calcTime 10>>
                <</button>>
            <</if>>
            <<if $unlockVar.locations.universitybasement.unlocked == true>>
                <<button [[University Basement | University_Hall_Basement]]>>
                    <<run Dialog.close()>>
                    <<calcTime 10>>
                <</button>>
            <</if>>
            <<if $unlockVar.locations.librarium.unlocked == true>>
                <<button [[Librarium | University_Librarium]]>>
                    <<run Dialog.close()>>
                    <<calcTime 10>>
                <</button>>
            <</if>>
        </div>
