:: StoryRightSidebar

<<nobr>>
    <<if $plrStats.stamina.max != 0>>
            <div id="staminaBarbkg" class="hzbarbkg"><div id="staminaBar" class="hzbar"></div></div>
            <span class="cyan">Stamina: </span><span id='ui-stamina'></span>
            <<run Stamina($plrStats.stamina.cur, $plrStats.stamina.max, "staminaBar", true)>>
            <hr>
    <</if>>
<</nobr>>\
<<nobr>>
    <<if $plrStats.life.max != 0>>
            <div id="lifeBarbkg" class="hzbarbkg"><div id="lifeBar" class="hzbar"></div></div>
            <span class="crimson">Lifeforce: </span><span id='ui-life'></span>
            <<run Life($plrStats.life.cur, $plrStats.life.max, "lifeBar", true)>>
            <hr>
    <</if>>
<</nobr>>\
<<nobr>>
    <<if $plrStats.focus.max != 0>>
        <div id="focusBarbkg" class="hzbarbkg"><div id="focusBar" class="hzbar"></div></div>
        <span class="greenyellow">Focus: </span><span id='ui-focus'></span>
        <<run FocusStat($plrStats.focus.cur, $plrStats.focus.max, "focusBar", true)>>
        <hr>
    <</if>>
<</nobr>>\
<<nobr>>
    <<if $plrStats.sanity.max != 0>>
        <div id="sanityBarbkg" class="hzbarbkg"><div id="sanityBar" class="hzbar"></div></div><<run Sanity($plrStats.sanity.cur, $plrStats.sanity.max, "sanityBar", true)>>
        <span class="purple">Sanity: </span><span id='ui-sanity'></span>
        <<run Sanity($plrStats.sanity.cur, $plrStats.sanity.max, "sanityBar", true)>>
        <hr>
    <</if>>
<</nobr>>\
<<nobr>>
    <<if $unlockVar.userInterface.spells == true>>
        <<link "Spells">>
            <<run
                Dialog.setup("Spells", "spellModal");
                Dialog.wiki(Story.get("Spells").processText());
                Dialog.open();
            >>
        <</link>>
    <</if>>
<</nobr>>