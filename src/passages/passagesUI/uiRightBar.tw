:: StoryRightSidebar

    <<nobr>>
        <<if $unlockVar.userInterface.spells == true>>
            <<link "Spellwork">>
                <<run
                    Dialog.setup('Form and Cast a Spell', 'spellwork');
                    Dialog.wiki(Story.get("Spell_Words_Modal").processText());
                    Dialog.open();
                >>
            <</link>>
        <</if>>
    <</nobr>>\
    <<nobr>>
        <<if $unlockVar.userInterface.actions == true>>
            <<link "Actions & Skills" >>
                <<run
                    Dialog.setup('Perform an Action?', 'actions');
                    Dialog.wiki(Story.get("Actions_Modal").processText());
                    Dialog.open();
                >>
            <</link>>
            <hr>
        <</if>>
    <</nobr>>
    <<nobr>>
        <div class='w3-bar w3-section'>
            <<if $plr.stats.stamina.max != 0>>
                <button id='plrstats-tablink' class='tablinks w3-bar-item w3-button w3-hover-none w3-hover-text-blue w3-hover-border-blue' style='width:33%' onclick='openTab(event, "plrstats")'>
                    <span class='tooltip stat-icons'>
                        <span class='tooltiptext cb'>Stats</span>
                        <i class='material-symbols-outlined'>
                            bar_chart
                        </i>
                    </span>
                </button>
            <</if>>
            <<if $npcs.amy.hasMet == true>>
                <button id='plrrels-tablink' class='tablinks w3-bar-item w3-button w3-hover-none w3-hover-text-blue w3-hover-border-blue' style='width:33%' onclick='openTab(event, "plrrels")'>
                    <span class='tooltip stat-icons'>
                        <span class='tooltiptext cb'>Relations</span>
                        <i class='material-symbols-outlined'>
                            groups
                        </i>
                    </span>
                </button>
            <</if>>
            <<if $unlockVar.events.firstSpellLearned == true>>
                <button id='plrdisc-tablink' class='tablinks w3-bar-item w3-button w3-hover-none w3-hover-text-blue w3-hover-border-blue' style='width:33%' onclick='openTab(event, "plrdisc")'>
                    <span class='tooltip stat-icons'>
                        <span class='tooltiptext cb'>Disciplines</span>
                        <i class='material-symbols-outlined'>
                            keyboard_double_arrow_up
                        </i>
                    </span>
                </button>
            <</if>>
        </div>
    <</nobr>>\
    <<nobr>>
        <div id='plrstats' class='tabcontent' style='display: block'>
            <<nobr>>
                <<if $plr.stats.stamina.max != 0>>
                    <div id="staminaBarbkg" class="hzbarbkg"><div id="staminaBar" class="hzbar"></div></div>
                    <span class="cyan">Stamina: </span><span id='ui-stamina'></span>
                    <br>
                    <<done>>
                        <<statsComments 'stamina'>>
                        <<run Stamina()>>
                    <</done>>
                    <span id="stamina-comment"></span>
                    <hr>
                <</if>>
            <</nobr>>
            <<nobr>>
                <<if $plr.stats.life.max != 0>>
                    <div id="lifeBarbkg" class="hzbarbkg"><div id="lifeBar" class="hzbar"></div></div>
                    <span class="crimson">Lifeforce: </span><span id='ui-life'></span>
                    <br>
                    <<done>>
                        <<statsComments 'life'>>
                        <<run Life()>>
                    <</done>>
                    <span id='life-comment'></span>
                    <hr>
                <</if>>
            <</nobr>>
            <<nobr>>
                <<if $plr.stats.focus.max != 0>>
                    <div id="focusBarbkg" class="hzbarbkg"><div id="focusBar" class="hzbar"></div></div>
                    <span class="greenyellow">Focus: </span><span id='ui-focus'></span>
                    <br>
                    <<done>>
                        <<statsComments 'focus'>>
                        <<run FocusStat()>>
                    <</done>>
                    <span id='focus-comment'></span>
                    <hr>
                <</if>>
            <</nobr>>
            <<nobr>>
                <<if $plr.stats.sanity.max != 0>>
                    <div id="sanityBarbkg" class="hzbarbkg"><div id="sanityBar" class="hzbar"></div></div>
                    <span class="purple">Sanity: </span><span id='ui-sanity'></span>
                    <br>
                    <<done>>
                        <<statsComments 'sanity'>>
                        <<run Sanity()>>
                    <</done>>
                    <span id='sanity-comment'></span>
                    <hr>
                <</if>>
            <</nobr>>
        </div>
    <</nobr>>\
    <<nobr>>
        <div id='plrrels' class='tabcontent'>
            <table id='rel-table' class='w3-table'>
                <tr>
                    <th>Name</th>
                    <th class='w3-text-green'>+</th>
                    <th class='w3-text-red'>-</th>
                    <th class='w3-text-purple'>X</th>
                    <th class='w3-text-orange'>!</th>
                </tr>
                <<if $npcs.janessa.hasMet>>
                    <<set _npcRef = 'janessa'>>
                    <<set _npcName = $npcs.janessa.name.firstName>>
                    <tr>
                        <td>
                            <<link _npcName>>
                                <<run
                                    Dialog.setup('Janessa Bio');
                                    Dialog.wiki(Story.get('Bio_Janessa').text);
                                    Dialog.open();
                                >>
                            <</link>>
                        </td>
                        <td><<= $plr.relations[_npcRef].positive>></td>
                        <td><<= $plr.relations[_npcRef].negative>></td>
                        <td><<= $plr.relations[_npcRef].intimate>></td>
                        <td><<= $plr.relations[_npcRef].suspicion>></td>
                    </tr>
                    <<unset _npcRef, _npcName>>
                <</if>>
                <<if $npcs.amy.hasMet>>
                    <<set _npcRef = 'amy'>>
                    <<set _npcName = $npcs.amy.name.firstName>>
                    <tr>
                        <td>
                            <<link _npcName>>
                                <<run
                                    Dialog.setup('Amy Bio');
                                    Dialog.wiki(Story.get('Bio_Amy').text);
                                    Dialog.open();
                                >>
                            <</link>>
                        </td>
                        <td><<= $plr.relations[_npcRef].positive>></td>
                        <td><<= $plr.relations[_npcRef].negative>></td>
                        <td><<= $plr.relations[_npcRef].intimate>></td>
                        <td><<= $plr.relations[_npcRef].suspicion>></td>
                    </tr>
                    <<unset _npcRef, _npcName>>
                <</if>>
                <<if $npcs.barden.hasMet>>
                    <<set _npcRef = 'barden'>>
                    <<set _npcName = $npcs.barden.name.firstName>>
                    <tr>
                        <td>
                            <<link _npcName>>
                                <<run
                                    Dialog.setup('Barden Bio');
                                    Dialog.wiki(Story.get('Bio_Barden').text);
                                    Dialog.open();
                                >>
                            <</link>>
                        </td>
                        <td><<= $plr.relations[_npcRef].positive>></td>
                        <td><<= $plr.relations[_npcRef].negative>></td>
                        <td><<= $plr.relations[_npcRef].intimate>></td>
                        <td><<= $plr.relations[_npcRef].suspicion>></td>
                    </tr>
                    <<unset _npcRef, _npcName>>
                <</if>>
                <<if $npcs.elliot.hasMet>>
                    <<set _npcRef = 'elliot'>>
                    <<set _npcName = $npcs.elliot.name.firstName>>
                    <tr>
                        <td>
                            <<link _npcName>>
                                <<run
                                    Dialog.setup('Elliot Bio');
                                    Dialog.wiki(Story.get('Bio_Elliot').text);
                                    Dialog.open();
                                >>
                            <</link>>
                        </td>
                        <td><<= $plr.relations[_npcRef].positive>></td>
                        <td><<= $plr.relations[_npcRef].negative>></td>
                        <td><<= $plr.relations[_npcRef].intimate>></td>
                        <td><<= $plr.relations[_npcRef].suspicion>></td>
                    </tr>
                    <<unset _npcRef, _npcName>>
                <</if>>
                <<if $npcs.juliette.hasMet>>
                    <<set _npcRef = 'juliette'>>
                    <<set _npcName = $npcs.juliette.name.firstName>>
                    <tr>
                        <td>
                            <<link _npcName>>
                                <<run
                                    Dialog.setup('Juliette Bio');
                                    Dialog.wiki(Story.get('Bio_Juliette').text);
                                    Dialog.open();
                                >>
                            <</link>>
                        </td>
                        <td><<= $plr.relations[_npcRef].positive>></td>
                        <td><<= $plr.relations[_npcRef].negative>></td>
                        <td><<= $plr.relations[_npcRef].intimate>></td>
                        <td><<= $plr.relations[_npcRef].suspicion>></td>
                    </tr>
                    <<unset _npcRef, _npcName>>
                <</if>>
                <<if $npcs.jonathan.hasMet>>
                    <<set _npcRef = 'jonathan'>>
                    <<set _npcName = $npcs.jonathan.name.firstName>>
                    <tr>
                        <td>
                            <<link _npcName>>
                                <<run
                                    Dialog.setup('Jonathan Bio');
                                    Dialog.wiki(Story.get('Bio_Jonathan').text);
                                    Dialog.open();
                                >>
                            <</link>>
                        </td>
                        <td><<= $plr.relations[_npcRef].positive>></td>
                        <td><<= $plr.relations[_npcRef].negative>></td>
                        <td><<= $plr.relations[_npcRef].intimate>></td>
                        <td><<= $plr.relations[_npcRef].suspicion>></td>
                    </tr>
                    <<unset _npcRef, _npcName>>
                <</if>>
                <<if $npcs.celeste.hasMet>>
                    <<set _npcRef = 'celeste'>>
                    <<set _npcName = $npcs.celeste.name.firstName>>
                    <tr>
                        <td>
                            <<link _npcName>>
                                <<run
                                    Dialog.setup('Celeste Bio');
                                    Dialog.wiki(Story.get('Bio_Celeste').text);
                                    Dialog.open();
                                >>
                            <</link>>
                        </td>
                        <td><<= $plr.relations[_npcRef].positive>></td>
                        <td><<= $plr.relations[_npcRef].negative>></td>
                        <td><<= $plr.relations[_npcRef].intimate>></td>
                        <td><<= $plr.relations[_npcRef].suspicion>></td>
                    </tr>
                    <<unset _npcRef, _npcName>>
                <</if>>
            </table>
        </div>
    <</nobr>>\
    <<nobr>>
        <div id='plrdisc' class='tabcontent'>
            <table id='disc-table' class='w3-table'>
                <tr>
                    <th>Discipline</th>
                    <th>Level</th>
                </tr>
                <<if $plr.disciplines.conjuration.level != 0>>
                    <tr>
                        <td>
                            <<link $plr.disciplines.conjuration.title>>
                                <<run
                                        Dialog.setup('School of Conjuration');
                                        Dialog.wiki(Story.get('Description_Conjuration').text);
                                        Dialog.open();
                                >>
                            <</link>>
                        </td>
                        <td>
                            <<=$plr.disciplines.conjuration.level.toFixed(2)>>
                        </td>
                    </tr>
                <</if>>
                <<if $plr.disciplines.elemental.level != 0>>
                    <tr>
                        <td>
                            <<link $plr.disciplines.elemental.title>>
                                <<run
                                        Dialog.setup('School of Elemental');
                                        Dialog.wiki(Story.get('Description_Elemental').text);
                                        Dialog.open();
                                    >>
                            <</link>>
                        </td>
                        <td>
                            <<=$plr.disciplines.elemental.level.toFixed(2)>>
                        </td>
                    </tr>
                <</if>>
                <<if $plr.disciplines.restoration.level != 0>>
                    <tr>
                        <td>
                            <<link $plr.disciplines.restoration.title>>
                                <<run
                                        Dialog.setup('School of Restoration');
                                        Dialog.wiki(Story.get('Description_Restoration').text);
                                        Dialog.open();
                                    >>
                            <</link>>
                        </td>
                        <td>
                            <<=$plr.disciplines.restoration.level.toFixed(2)>>
                        </td>
                    </tr>
                <</if>>
                <<if $plr.disciplines.transmutation.level != 0>>
                    <tr>
                        <td>
                            <<link $plr.disciplines.transmutation.title>>
                                <<run
                                        Dialog.setup('School of Transmutation');
                                        Dialog.wiki(Story.get('Description_Transmutation').text);
                                        Dialog.open();
                                >>
                            <</link>>
                        </td>
                        <td>
                            <<=$plr.disciplines.transmutation.level.toFixed(2)>>
                        </td>
                    </tr>
                <</if>>
            </table>
        </div>
    <</nobr>>
    
:: Actions_Modal
    <br>
    <<nobr>>
        <div class= 'spell-word-grid'>
            <<if $skillVars.meditation.unlocked == true>>
                <<hovertip $skillVars.meditation.description>>
                    <div class='spell-word-grid-item'>
                        <<button [[Meditation | Skills_Meditation_Use]]>>
                            <<UseSkill mundane meditation>>
                        <</button>>
                    </div>
                <</hovertip>>
            <</if>>
        </div>
    <</nobr>>