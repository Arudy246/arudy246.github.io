:: Item-Inventories [init]

    /* Inventory Variables */
    <<newinv $plrinvbooks>>
    <<newinv $plrinvmaterials>>
    <<newinv $plrinvspells>>
    <<newinv $plrinvmisc>>

    /* Item SimpleStorage Variables */
    <<consumable "mapSchool" "A Guide to Magnus Schola">>
            <<nobr>>
                <<readBook miscbook mapSchool>>
            <</nobr>>
        <<description>>\
            $bookMisc.mapSchool.description        
    <</consumable>>

    /* Item Detail and Unlock Arrays */
    <<set $bookMisc = {
        mapSchool: {
            title: "A Guide to Magnus Schola",
            description: "A book of locations, maps, and assorted histories of Magnus Schola.",
            pagesRead: 0,
            pagesTotal: 13,
            pageUnlocks: {
                1: "alstonresidence",
                2: "librarium",
                3: "dininghall",
                4: "conservatorium",
                5: "theexchange",
                6: "leynode",
                7: "gymnasium",
                8: "sigilarium",
                9: "artifice",
                10: "pentadentrix",
                11: "headmasterstudy",
                12: "medicalwing",
                13: "professoroffices"
                end: true
            }
        },
        mapArea: {
            title: "Nome and her Mysteries",
            description: "A tome of Nome's hidden history.",
            pagesRead: 0,
            pagesTotal: 5,
            pageUnlocks: {
                1: "tradingpost",
                2: "cinema",
                3: "hospital",
                4: "cemetary",
                5: "salooninn",
                end: true
            }
        }  
    }>>

    <<set $bookSkills = {
    }>>

    <<set $bookDisciplines = {
        aburation: {
            abook: {
                title: "",
                description: "",
                pagesRead: 0,
                pagesTotal: 0,
                pageUnlocks: {
                    1: ""
                }
            }
        },
        alchemy: {
            abook: {
                title: "",
                description: "",
                pagesRead: 0,
                pagesTotal: 0,
                pageUnlocks: {
                    1: ""
                }
            }
        },
        illusion: {
            bookIllusion1: {
                title: "Illusion: A Primer",
                description: "A treatise on the Illusion discipline for the newly of age mage.",
                pagesRead: 0,
                pagesTotal: 20,
                pageUnlocks: {
                    1: "Floating Flame",
                    end: true
                }
            }
        }
    }>>