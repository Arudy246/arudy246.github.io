:: Item-Inventories [init]

    /* Inventory Variables */
    <<newinv $plrinvbooks>>
    <<newinv $plrinvmaterials>>
    <<newinv $plrinvspells>>
    <<newinv $plrinvmisc>>

    /* Item SimpleStorage Variables */

    /*
    <<consumable>>
        <<nobr>>

        <</nobr>>
        <<description>>\

    <</consumable>>
    */

    <<consumable "mapSchool" "A Guide to Magnus Schola">>
        <<nobr>>
            <<readBook miscbook mapSchool>>
        <</nobr>>
        <<description>>\
            $bookMisc.mapSchool.description You have read $bookMisc.mapSchool.pagesRead out of $bookMisc.mapSchool.pagesTotal chapters.
    <</consumable>>

    <<consumable "mapTown" "Nome and her Mysteries">>
        <<nobr>>
            <<readBook miscbook mapTown>>
        <</nobr>>
        <<description>>\
            $bookMisc.mapTown.description You have read $bookMisc.mapTown.pagesRead out of $bookMisc.mapTown.pagesTotal chapters.
    <</consumable>>

    <<consumable "spellsBasic" "Basic Spellwork: A Child's Primer">>
        <<nobr>>
            <<readBook spellbook spellsBasic>>
        <</nobr>>
        <<description>>\
            $bookSpell.spellsBasic.description You have read $bookSpell.spellsBasic.pagesRead out of $bookSpell.spellsBasic.pagesTotal chapters.
    <</consumable>>

    /* Item Detail and Unlock Arrays */
    <<set $bookMisc = {
        mapSchool: {
            title: "A Guide to Magnus Schola",
            description: "A book of locations, maps, and assorted histories of Magnus Schola.",
            pagesRead: 0,
            pagesTotal: 13,
            pageUnlocks: {
                1: "starrresidence",
                2: "librarium",
                3: "cafeteria",
                4: "conservatorium",
                5: "theexchange",
                6: "leynode",
                7: "gymnasium",
                8: "sigilarium",
                9: "artifice",
                10: "pentadentrix",
                11: "deanstudy",
                12: "clinic",
                13: "professoroffices"
            }
        },
        mapTown: {
            title: "Nome and her Mysteries",
            description: "A tome of Nome's hidden histories.",
            pagesRead: 0,
            pagesTotal: 5,
            pageUnlocks: {
                1: "tradingpost",
                2: "cinema",
                3: "hospital",
                4: "cemetary",
                5: "salooninn"
            }
        }  
    }>>

    <<set $bookSkills = {
    }>>

    <<set $bookSpell = {
        spellsBasic: {
            title: "Basic Spellwork: A Child's Primer",
            description: "An introduction to basic spellwork for the child-aged practitioner.",
            costMult: 0.4,
            pagesRead: 0,
            pagesTotal: 4,
            pageUnlocks: {
                1: function() {
                        state.setVar('$spellWords.target.self.unlocked', true);
                        let x = state.getVar('$spellWords.target.self');
                        return x
                    },
                2: function() {
                        state.setVar('$spellWords.target.room.unlocked', true);
                        let x = state.getVar('$spellWords.target.room');
                        return x
                    },
                3: function() {
                        state.setVar('$spellWords.effect.light.unlocked', true);
                        let x = state.getVar('$spellWords.effect.light');
                        return x
                    },
                4: function() {
                        state.setVar('$spellWords.duration.immediate.unlocked', true);
                        let x = state.getVar('$spellWords.duration.immediate');
                        return x
                    }
            }
        }
    }>>