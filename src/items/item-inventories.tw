:: Item-Inventories [init]

    /* Inventory Variables */
    <<newinv $plrinvbooks>>
    <<newinv $plrinvmaterials>>
    <<newinv $plrinvspells>>
    <<newinv $plrinvmisc>>

    /* Item SimpleStorage Variables */

    /*
    <<consumable>>
        <<nobr>>

        <</nobr>>
        <<description>>\

    <</consumable>>
    */

    <<consumable "mapSchool" "A Guide to Magnus Schola">>
        <<nobr>>
            <<readBook miscbook mapSchool>>
        <</nobr>>
        <<description>>\
            $bookMisc.mapSchool.description        
    <</consumable>>

    <<consumable "mapTown" "Nome and her Mysteries">>
        <<nobr>>
            <<readBook miscbook mapTown>>
        <</nobr>>
        <<description>>\
            $bookMisc.mapTown.description
    <</consumable>>

    <<consumable "illusion1" "Illusion: A Child's Primer">>
        <<nobr>>
            <<readBook spellbook illusion1 illusion>>
        <</nobr>>
        <<description>>\
            $bookDisciplines.illusion.illusion1.description
    <</consumable>>

    /* Item Detail and Unlock Arrays */
    <<set $bookMisc = {
        mapSchool: {
            title: "A Guide to Magnus Schola",
            description: "A book of locations, maps, and assorted histories of Magnus Schola.",
            pagesRead: 0,
            pagesTotal: 13,
            pageUnlocks: {
                1: "alstonresidence",
                2: "librarium",
                3: "dininghall",
                4: "conservatorium",
                5: "theexchange",
                6: "leynode",
                7: "gymnasium",
                8: "sigilarium",
                9: "artifice",
                10: "pentadentrix",
                11: "headmasterstudy",
                12: "medicalwing",
                13: "professoroffices"
            }
        },
        mapTown: {
            title: "Nome and her Mysteries",
            description: "A tome of Nome's hidden histories.",
            pagesRead: 0,
            pagesTotal: 5,
            pageUnlocks: {
                1: "tradingpost",
                2: "cinema",
                3: "hospital",
                4: "cemetary",
                5: "salooninn"
            }
        }  
    }>>

    <<set $bookSkills = {
    }>>

    <<set $bookDisciplines = {
        aburation: {
            abook: {
                title: "",
                description: "",
                pagesRead: 0,
                pagesTotal: 0,
                pageUnlocks: {
                    1: ""
                }
            }
        },
        alchemy: {
            abook: {
                title: "",
                description: "",
                pagesRead: 0,
                pagesTotal: 0,
                pageUnlocks: {
                    1: ""
                }
            }
        },
        illusion: {
            illusion1: {
                title: "Illusion: A Child's Primer",
                description: "An introduction to the Illusion discipline for the newly come of age mage.",
                pagesRead: 0,
                pagesTotal: 20,
                pageUnlocks: {
                    1: "floatingflame",
                    3: "some unlock",
                    9: "some unlock",
                    13: "some unlock",
                    20: "some unlock"
                }
            }
        }
    }>>