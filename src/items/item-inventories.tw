:: inventory.strings
    use: Read

:: Item-Inventories [init]

    /* Inventory Variables */
    <<newinv $plrinvbooks inspect>>
    <<newinv $plrinvmaterials inspect>>
    <<newinv $plrinvmisc inspect>>
    <<newinv $plrCurrencies inspect>>

    /* Item SimpleStorage Variables */

    /*
    <<consumable>>
        <<nobr>>

        <</nobr>>
        <<description>>\

    <</consumable>>
    */

    <<item 'goldflake' 'Gold Flakes'>>
        <<description>>\
            A bunch of small gold flakes. Looks valuable enough to keep.
    <</item>>

    <<consumable "mapSchool" "A Guide to Magnus Schola">>
        <<nobr>>
            <<readBook miscbook mapSchool>>
        <</nobr>>
        <<description>>\
            $bookMisc.mapSchool.description You have read $bookMisc.mapSchool.pagesRead out of $bookMisc.mapSchool.pagesTotal chapters.
    <</consumable>>

    <<consumable "mapTown" "Nome and her Mysteries">>
        <<nobr>>
            <<readBook miscbook mapTown>>
        <</nobr>>
        <<description>>\
            $bookMisc.mapTown.description You have read $bookMisc.mapTown.pagesRead out of $bookMisc.mapTown.pagesTotal chapters.
    <</consumable>>

    <<consumable "spellsBasic" "Basic Spellwork: A Child's Primer">>
        <<nobr>>
            <<readBook spellbook spellsBasic>>
        <</nobr>>
        <<description>>\
            $bookSpell.spellsBasic.description You have read $bookSpell.spellsBasic.pagesRead out of $bookSpell.spellsBasic.pagesTotal chapters.
    <</consumable>>

    /* Item Detail and Unlock Arrays */
    <<set $bookMisc = {
        mapSchool: {
            title: "A Guide to Magnus Schola",
            description: "A book of locations, maps, and assorted histories of Magnus Schola.",
            pagesRead: 0,
            pagesTotal: 8,
            pageUnlocks: {
                1: function() {
                        state.setVar('$unlockVar.locations.starrresidence.unlocked', true)
                        let x = state.getVar('$unlockVar.locations.starrresidence.name')
                        return x
                    },
                2: function() {
                        state.setVar('$unlockVar.locations.universityentrance.unlocked', true)
                        let x = state.getVar('$unlockVar.locations.universityentrance.name')
                        return x
                    },
                3: function() {
                        state.setVar('$unlockVar.locations.cafeteria.unlocked', true)
                        let x = state.getVar('$unlockVar.locations.cafeteria.name')
                        return x
                    },
                4: function() {
                        state.setVar('$unlockVar.locations.clinic.unlocked', true)
                        let x = state.getVar('$unlockVar.locations.clinic.name')
                        return x
                    },
                5: function() {
                        state.setVar('$unlockVar.locations.universityclasses.unlocked', true)
                        let x = state.getVar('$unlockVar.locations.universityclasses.name')
                        return x
                    },
                6: function() {
                        state.setVar('$unlockVar.locations.universityshops.unlocked', true)
                        let x = state.getVar('$unlockVar.locations.universityshops.name')
                        return x
                    },
                7: function() {
                        state.setVar('$unlockVar.locations.professoroffices.unlocked', true)
                        let x = state.getVar('$unlockVar.locations.professoroffices.name')
                        return x
                    },
                8: function() {
                        state.setVar('$unlockVar.locations.universitybasement.unlocked', true)
                        let x = state.getVar('$unlockVar.locations.universitybasement.name')
                        return x
                    },
                9: function() {
                        state.setVar('$unlockVar.locations.librarium.unlocked', true)
                        let x = state.getVar('$unlockVar.locations.librarium.name')
                        return x
                    }
            }
        },
        mapTown: {
            title: "Nome and her Mysteries",
            description: "A tome of Nome's hidden histories.",
            pagesRead: 0,
            pagesTotal: 5,
            pageUnlocks: {
                1: "tradingpost",
                2: "cinema",
                3: "hospital",
                4: "cemetary",
                5: "salooninn"
            }
        }  
    }>>

    <<set $bookSkills = {
    }>>

    <<set $bookSpell = {
        spellsBasic: {
            title: "Basic Spellwork: A Child's Primer",
            description: "An introduction to basic spellwork for the child-aged practitioner.",
            costMult: 0.4,
            pagesRead: 0,
            pagesTotal: 7,
            pageUnlocks: {
                1: function() {
                        state.setVar('$spellWords.target.self.unlocked', true);
                        let x = state.getVar('$spellWords.target.self');
                        return x
                    },
                2: function() {
                        state.setVar('$spellWords.target.room.unlocked', true);
                        let x = state.getVar('$spellWords.target.room');
                        return x
                    },
                3: function() {
                        state.setVar('$spellWords.effect.light.unlocked', true);
                        let x = state.getVar('$spellWords.effect.light');
                        return x
                    },
                4: function() {
                        state.setVar('$spellWords.duration.immediate.unlocked', true);
                        let x = state.getVar('$spellWords.duration.immediate');
                        return x
                    },
                5: function() {
                        state.setVar('$spellWords.effect.damage.unlocked', true);
                        let x = state.getVar('$spellWords.effect.damage');
                        return x
                    },
                6: function() {
                        state.setVar('$spellWords.target.other.unlocked', true);
                        let x = state.getVar('$spellWords.target.other');
                        return x
                    },
                7: function() {
                        state.setVar('$spellWords.effect.clean.unlocked', true);
                        let x = state.getVar('$spellWords.effect.clean');
                        return x
                    }
            }
        },
        manusciptHeal: {
            title: 'Vulnus and its Uses',
            description: 'A single page manuscript containing just a few paragraphs.',
            costMult: 0.4,
            pagesRead: 0,
            pagesTotal: 1,
            pageUnlocks: {
                1: function() {
                        state.setVar('$spellWords.effect.heal.unlocked', true);
                        let x = state.getVar('$spellWords.effect.heal');
                        return x
                    }
            }
        }
    }>>

    <<set $bookDisc = {
        conjuration1: {
            title: 'The Essentials of Conjuration',
            description: 'A primer on the principles and operations of the conujuration discipline.',
            discipline: 'conjuration',
            gainLvl: 1,
            costMult: 0.5,
            pagesRead: 0,
            pagesTotal: 20,
        }
    }>>