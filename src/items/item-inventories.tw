:: Item-Inventories [init]

    /* Inventory Variables */
    <<newinv $plrinvbooks>>
    <<newinv $plrinvmaterials>>
    <<newinv $plrinvspells>>
    <<newinv $plrinvmisc>>

    /* Item SimpleStorage Variables */

    /*
    <<consumable>>
        <<nobr>>

        <</nobr>>
        <<description>>\

    <</consumable>>
    */

    <<consumable "mapSchool" "A Guide to Magnus Schola">>
        <<nobr>>
            <<readBook miscbook mapSchool>>
        <</nobr>>
        <<description>>\
            $bookMisc.mapSchool.description You have read $bookMisc.mapSchool.pagesRead out of $bookMisc.mapSchool.pagesTotal chapters.
    <</consumable>>

    <<consumable "mapTown" "Nome and her Mysteries">>
        <<nobr>>
            <<readBook miscbook mapTown>>
        <</nobr>>
        <<description>>\
            $bookMisc.mapTown.description You have read $bookMisc.mapTown.pagesRead out of $bookMisc.mapTown.pagesTotal chapters.
    <</consumable>>

    <<consumable "illusion1" "Illusion: A Child's Primer">>
        <<nobr>>
            <<readBook spellbook illusion1>>
        <</nobr>>
        <<description>>\
            $bookSpell.illusion1.description You have read $bookSpell.illusion1.pagesRead out of $bookSpell.illusion1.pagesTotal chapters.
    <</consumable>>

    /* Item Detail and Unlock Arrays */
    <<set $bookMisc = {
        mapSchool: {
            title: "A Guide to Magnus Schola",
            description: "A book of locations, maps, and assorted histories of Magnus Schola.",
            pagesRead: 0,
            pagesTotal: 13,
            pageUnlocks: {
                1: "starrresidence",
                2: "librarium",
                3: "cafeteria",
                4: "conservatorium",
                5: "theexchange",
                6: "leynode",
                7: "gymnasium",
                8: "sigilarium",
                9: "artifice",
                10: "pentadentrix",
                11: "deanstudy",
                12: "clinic",
                13: "professoroffices"
            }
        },
        mapTown: {
            title: "Nome and her Mysteries",
            description: "A tome of Nome's hidden histories.",
            pagesRead: 0,
            pagesTotal: 5,
            pageUnlocks: {
                1: "tradingpost",
                2: "cinema",
                3: "hospital",
                4: "cemetary",
                5: "salooninn"
            }
        }  
    }>>

    <<set $bookSkills = {
    }>>

    <<set $bookSpell = {
        illusion1: {
            title: "Illusion: A Child's Primer",
            school: "illusion",
            description: "An introduction to the Illusion discipline for the young practitioner.",
            pagesRead: 0,
            pagesTotal: 20,
            pageUnlocks: {
                1: "floatingflame",
                2: "",
                3: "",
                9: "",
                13: "",
                20: ""
            }
        }
    }>>