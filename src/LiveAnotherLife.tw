    // End Simple Inventory

:: Widgets[widget]

    /* relGain Amy 10 */
    <<widget "relGain">>
        <<set $plrRel[_args[0]] += _args[1] + ($plrBody.dynamic.atttractiveness / 10)>>
        <<set $relNpcTemp = _args[0]>>
        <<set $relAmtTemp = _args[1]>>
    <</widget>>

    <<widget "printRelGain">>
        <<nobr>>
            <<if $relAmtTemp>>
                <<if $relAmtTemp > 0 >>
                    <<print '<span class="green">Your relationship with ' +  $npcs[$relNpcTemp].formal + ' has improved!</span>'>>
                <<else>>
                    <<print '<span class="red">Your relationship with ' + $npcs[$relNpcTemp].formal + ' has deteriorated.</span>'>>
                <</if>>
                <<unset $relAmtTemp, $relNpcTemp>>
            <</if>>
        <</nobr>>
    <</widget>>

    <<widget "calcAttractiveness">>
        <<nobr>>
            <<set $plrBody.dynamic.atttractiveness = 0>>
            <<if $plrBody.static.sex == "male" && ($plrBody.static.height == "tall" || $plrBody.static.height == "very tall")>>
                <<set $plrBody.dynamic.atttractiveness += 10>>
            <<elseif $plrBody.static.sex == "female" && ($plrBody.static.height == "average" || $plrBody.static.height == "short")>>
                <<set $plrBody.dynamic.atttractiveness += 10>>
            <</if>>

            <<if $plrBody.static.faceShape == "oblong" || $plrBody.static.faceShape == "square">>
                <<set $plrBody.dynamic.atttractiveness += 10>>
            <</if>>

            <<if $plrBody.dynamic.weight >= 20 && $plrBody.dynamic.weight <= 55>>
                <<set $plrBody.dynamic.atttractiveness += 10>>
            <</if>>

            <<if $plrBody.static.sex == "female">>
                <<set $plrBody.dynamic.atttractiveness *= 1.1>>
        <</if>>
        <</nobr>>
    <</widget>>

    <<nobr>>
        <<widget "calcTime">>
                <<if _args[0]>>
                    <<set $dateTime.min += _args[0]>>
                <</if>>
                <<if $dateTime.min >= 60>>
                    <<set $dateTime.hour += 1>>
                    <<set $dateTime.min -= 60>>
                <</if>>
                <<if $dateTime.hour >= 24>>
                    <<set $dateTime.date += 1>>
                    <<set $dateTime.hour -= 24>>
                    <<set $dateTime.day += 1>>
                <</if>>
                <<if $dateTime.day > 7 >>
                    <<set $dateTime.day = 1>>
                <</if>>
                <<if $dateTime.date > 30>>
                    <<set $dateTime.month += 1>>
                    <<set $dateTime.date -= 30>>
                <</if>>
                <<if $dateTime.month > 12 >>
                    <<set $dateTime.year += 1>>
                    <<set $dateTime.month = 1>>
                <</if>>

                <<replace "#timeplusdate">>
                    <<if $dateTime.day == 1>>
                        <<set $dateTime.dayName = "Monday">>
                    <</if>>
                    <<if $dateTime.day == 2>>
                        <<set $dateTime.dayName = "Tuesday">>
                    <</if>>
                    <<if $dateTime.day == 3>>
                        <<set $dateTime.dayName = "Wednesday">>
                    <</if>>
                    <<if $dateTime.day == 4>>
                        <<set $dateTime.dayName = "Thursday">>
                    <</if>>
                    <<if $dateTime.day == 5>>
                        <<set $dateTime.dayName = "Friday">>
                    <</if>>
                    <<if $dateTime.day == 6>>
                        <<set $dateTime.dayName = "Saturday">>
                    <</if>>
                    <<if $dateTime.day == 7>>
                        <<set $dateTime.dayName = "Sunday">>
                    <</if>>
                    <<if $dateTime.month == 1>>
                        <<set $dateTime.monthName = "January">>
                    <</if>>
                    <<if $dateTime.month == 2>>
                        <<set $dateTime.monthName = "February">>
                    <</if>>
                    <<if $dateTime.month == 3>>
                        <<set $dateTime.monthName = "March">>
                    <</if>>
                    <<if $dateTime.month == 4>>
                        <<set $dateTime.monthName = "April">>
                    <</if>>
                    <<if $dateTime.month == 5>>
                        <<set $dateTime.monthName = "May">>
                    <</if>>
                    <<if $dateTime.month == 6>>
                        <<set $dateTime.monthName = "June">>
                    <</if>>
                    <<if $dateTime.month == 7>>
                        <<set $dateTime.monthName = "July">>
                    <</if>>
                    <<if $dateTime.month == 8>>
                        <<set $dateTime.monthName = "August">>
                    <</if>>
                    <<if $dateTime.month == 9>>
                        <<set $dateTime.monthName = "September">>
                    <</if>>
                    <<if $dateTime.month == 10>>
                        <<set $dateTime.monthName = "October">>
                    <</if>>
                    <<if $dateTime.month == 11>>
                        <<set $dateTime.monthName = "November">>
                    <</if>>
                    <<if $dateTime.month == 12>>
                        <<set $dateTime.monthName = "December">>
                    <</if>>
                    <<if $dateTime.hour <= 9 && $dateTime.min <= 9>>
                        <<print '<br>0' + $dateTime.hour + ':0' + $dateTime.min + '<br>'>>
                    <<elseif $dateTime.hour <= 9>>
                        <<print '<br>0' + $dateTime.hour + ':' + $dateTime.min + '<br>'>>
                    <<elseif $dateTime.min <= 9>>
                        <<print '<br>' + $dateTime.hour + ':0' + $dateTime.min + '<br>'>>
                    <<else>>
                        <<print '<br>' + $dateTime.hour + ':' + $dateTime.min + '<br>'>>
                    <</if>>
                    <<print $dateTime.dayName + ' ' + $dateTime.monthName + ' ' + $dateTime.date + ', ' + $dateTime.year + '<br>'>>
                <</replace>>
        <</widget>>
    <</nobr>>

    /* readBook $bookMisc mapSchool location/spell/skill */
    <<nobr>>
        <<widget "readBook">>
            <<set _array = _args[0]>>
            <<set _bookID = _args[1]>>
            <<set _unlocktype = _args[2]>>

            <<if _array._bookID.pagesRead != _array._bookID.pagesTotal>>
                <<set _array._bookID.pagesRead += 1>>
                <<pickup $plrinvbooks _bookID 1>>
                <<calcTime 20>>
            <<else>>
                <<drop $plrinvbooks _bookID>>
            <</if>>



        <</widget>>
    <</nobr>>
:: CustomStyleSheet[stylesheet]
    @font-face {
        font-family: HeaderText;
        src: url("fonts/BreatheFireIi-2z9W.ttf");
    }
    .hidden {
        visibility: hidden;
    }
    #story-title {
        font-family: HeaderText;
        font-size: 1.5em;
        letter-spacing: 1px;
        text-shadow: 2px 3px black;
    }
    #story-author {
        margin: 0em 1em 0em 0em
    }
    h2 {
        font-size: 5em;
        text-shadow: 5px 5px rgba(102, 179, 255, 0.1);
        letter-spacing: 1px;
    }
    .title-image {
        width: 35%;
    }
    .title-text {
        position: absolute;
        top: 25%;
        left: 60%;
        transform: translate(-50%, -50%);
    }
    .wood-text {
        $random-text: 'live another life';
        background: url('img/title-texture.jpg');
        background-size: 75%;
        position: absolute;

        font-size: $extra-large * 1.5;
        text-transform: uppercase;
        font-family: HeaderText;
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        top: 8%;
        left: 42.5%;
        &:after {
        $stroke-width: $extra-large * 0.05;
        content: $random-text;
        position: absolute;
        -webkit-text-stroke-width: $stroke-width;
        -webkit-text-stroke-color: rgba(black, 0.6);
        left: 2px;
        top: 2px;
        }
    }
    /* .outerborder {
        position: relative;
        image: url("img/title-border.png");
    }
    .outerborder:before {
        content: " ";
        position: absolute;
        z-index: -1;
        top: 5px;
        right: 5px;
        bottom: 5px;
        left: 5px;
        border: 10px solid transparent;
    } */
