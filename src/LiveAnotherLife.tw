    }
    .text-center {
        text-align: center;
    }
    #ui-bar {
        width: 19em;
        background-image: url("img/bg.png");
        border-right: 10px groove #262626;
    }
    #ui-bar-history {
        margin: 0em 4.5em 0em 0em;
    }
    #ui-bar-body {
        padding: 0em 6em 0em 1em;
    }
