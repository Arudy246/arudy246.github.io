:: StoryData
    {
        "ifid": "49DA3755-D957-4866-AF0F-EC39C2B73777",
        "format": "SugarCube",
        "format-version": "2.36.1",
        "start": "Start"
    }

:: StoryTitle
    Live Another Life

:: StoryBanner
    <img src='img/symbol.png'/>

:: StoryInit

    /* Inventory Variables */
    <<newinv $plrinvbooks>>
    <<newinv $plrinvmaterials>>
    <<newinv $plrinvspells>>
    <<newinv $plrinvmisc>>

    /* Items Variables */
    <<consumable "Test Book">>
            <<nobr>>
                <<if $bookMisc.mapSchool.pagesRead != $bookMisc.mapSchool.pagesTotal>>
                    <<set $bookMisc.mapSchool.pagesRead += 1>>
                    <<pickup $plrinvbooks "Test Book" 1>>
                    <<calcTime 20>>
                <<else>>
                    <<drop $plrinvbooks "Test Book" 1>>
                <</if>>
            <</nobr>>
        <<description>>\
            This is a test book...
    <</consumable>>

    <<set $dateTime = {
        hour: 20,
        min: 30,
        day: 7,
        month: 1,
        date: 8,
        year: 2023,
        dayName: "",
        monthName: ""
    }>>

    /*-----Player Stats and Info-----*/
    /*---the dynamic body stats are able to change and the description of the player will change based on a range.---*/
    /*-weight is on a range of 1-100, 1-15 is skinny, 16-30 is fit, 30-70 is average, 70-86 is husky, 86-100 is fat-*/
    /*-hair length is on a range of 1-7, 1 bald or shaved, 2 is ear length, 3 is neck length, 4 is shoulder length, 5 is chest length, 6 is waist, 7 is knees-*/
    /*-atttractiveness is gauged on a combination of height, face shape, hair length, and heavily by weight (equation is different between sexes)*/
    /*XXXXX Add beard stats XXXXX*/
    <<set $plrName = {
        fName: "",
        lName: "",
        prefix: "",
        formal: ""
    }>>

