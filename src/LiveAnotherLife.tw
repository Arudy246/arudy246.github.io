:: TestingGrounds

    <<button "Generate Identity">>
        <<set $plrName.fName = "Azure">>
        <<set $plrName.lName = "Paine">>
        <<set $plrName.prefix = "Mr.">>
        <<set $plrBody.static.sex = "male">>
        <<set $plrBody.static.hairColor = "blue">>
        <<set $plrBody.static.hairStyle = "mohawk">>
        <<set $plrBody.static.eyeColor = "amber">>
        <<set $plrBody.static.faceShape = "square">>
        <<set $plrBody.static.height = "tall">>
        <<set $plrBody.dynamic.hairLength = 1>>
        <<set $plrBody.dynamic.weight = 35>>
        <<calcAttractiveness>>
    <</button>>\
    <<button "Setup Stats">>
        <<set $plrStats.stamina.max = 10>>
        <<set $plrStats.stamina.cur = 10>>
        <<set $plrStats.life.max = 10>>
        <<set $plrStats.life.cur = 10>>
        <<set $plrStats.hygiene.max = 10>>
        <<set $plrStats.hygiene.cur = 10>>
        <<set $plrStats.sanity.max = 3>>
        <<set $plrStats.sanity.cur = 3>>
        <<set $plrStats.wake.max = 5>>
        <<set $plrStats.wake.cur = 5>>
    <</button>>

    <<button "Increase Minutes 55">>
        <<calcTime 55>>
    <</button>>\
    <<button "Increase Minutes 5">>
        <<calcTime 5>>
    <</button>>

    <<button "Decrease Life -1">>
        <<set $plrStats.life.cur -= 1>>
        <<run Life($plrStats.life.cur, $plrStats.life.max, "verticallifebar", false)>>
    <</button>>\
    <<button "Decrease Sanity -0.1">>
        <<set $plrStats.sanity.cur -= 0.1>>
        <<run Sanity($plrStats.sanity.cur, $plrStats.sanity.max, "verticalsanitybar", false)>>
    <</button>>

    <<button "Give Test Book">>
        <<pickup $plrinvbooks "mapSchool" 1>>
        <<run 
            Dialog.setup("Book Found");
            Dialog.wiki("The book is titled '" + $bookMisc.mapSchool.title + "'. The first page reads '" + $bookMisc.mapSchool.description + "'.");
            Dialog.open();
        >>
    <</button>>
