:: Spell-Variables [init]
    <<set $spellCastVar = {
        spellTarget: '',
        spellDuration: '',
        spellEffect: '',
        spellEnhancement: '',
        spellCost: 0,
        spellDiscipline: '',
        passageTag: '',
        badCombo: false,
        passageTitle: '',
        availableTargets: {
            npcs: [],
            critters: []
        },
        damageDone: '',
        healDone: ''
    }>>

    <<set $spellWords = {
        target: {
            self: {
                latin: 'Ego',
                description: 'Sets the caster as the focus of the spell.',
                unlocked: false,
                costMult: 0.5,
                onCast: function() {
                    let x = state.getVar('$plr');
                    State.setVar('$spellCastVar.spellTarget', x);
                }
            },
            other: {
                latin: 'Alius',
                description: 'Sets a nearby person or creature as the focus of the spell.',
                unlocked: false,
                costMult: 1,
                onCast: function() {
                    let x = ''
                    let y = ''
                    if (State.getVar('$spellCastVar.availableTargets.npcs[0]')) {
                        x = State.getVar('$spellCastVar.availableTargets.npcs[0]')
                        y = '$npcs.'

                    } else if (State.getVar('$spellCastVar.availableTargets.critters[0]')) {
                        x = State.getVar('$spellCastVar.availableTargets.critters[0]')
                        y = '$critters.'
                    }

                    let adrs = y + x
                    let r = State.getVar(adrs)
                    State.setVar('$spellCastVar.spellTarget', r);
                }
            },
            room: {
                latin: 'Praesto',
                description: 'Choose the room you are in as the focus of the spell.',
                unlocked: false,
                costMult: 1.5,
                onCast: function() {
                    state.setVar('$spellCastVar.spellTarget', 'room')
                }
            },
            outdoors: {
                latin: 'Circa',
                description: 'Selects a large outdoor area (i.e. a courtyard, tree grove, or park) as the focus of the spell.',
                unlocked: false,
                costMult: 1.5,
                onCast: function() {
                    return 'xxxxx'
                }
            },
            item: {
                latin: 'Item',
                description: 'Picks an item as the focus of the spell.',
                unlocked: false,
                costMult: 1,
                onCast: function() {
                    return 'xxxxx'
                }
            }
        },
        duration: {
            immediate: {
                latin: 'Nunc',
                description: 'The spell effect is applied immediately.',
                costMult: 1,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 0);
                }
            },
            minute: {
                latin: 'Mox',
                description: 'The spell applies the affect now and for a few minutes.',
                costMult: 5,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 10);
                }
            },
            hour: {
                latin: 'Postea',
                description: 'The spell applies the effect now and for about an hour.',
                costMult: 10,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 60);
                }
            },
            day: {
                latin: 'Hodie',
                description: 'The spell applies the effect for about a day.',
                costMult: 20,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 1440);
                }
            },
            week: {
                latin: 'Septimana',
                description: 'The spell applies the effect for around one week',
                costMult: 40,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 10080);
                }
            },
            month: {
                latin: 'Mensis',
                description: 'The spell applies the effect for a whole month.',
                costMult: 60,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 40320);
                }
            }
        },
        effect: {
            damage: {
                latin: 'Damnum',
                description: 'Uses the destructive aspect of elemental magic to cause physical injuries.',
                costMult: 1,
                unlocked: false,
                discipline: 'elemental',
                badCombo : function(){
                    if(State.getVar('$spellCastVar.spellTarget') == 'room' || State.getVar('$spellCastVar.spellTarget') == 'playerHome') {
                        State.setVar('$spellCastVar.badCombo', 'What did this room do to deserve such harsh treatment?')
                    } else if (!State.getVar('$spellCastVar.availableTargets.npcs[0]') && !State.getVar('$spellCastVar.availableTargets.critters[0]') && State.getVar('$spellCastVar.spellTarget') != State.getVar('$plr')) {
                        State.setVar('$spellCastVar.badCombo', 'There are no foes and nobody to target here.')
                    } else {
                    State.setVar('$spellCastVar.badCombo', false)
                    }
                },
                onCast: function() {
                    let curLife = state.getVar('$spellCastVar.spellTarget.stats.life.cur');
                    let maxLife = state.getVar('$spellCastVar.spellTarget.stats.life.max');
                    let mult = state.getVar('$spellCastVar.spellEnhancement');

                    if(state.getVar('$spellCastVar.spellTarget') == state.getVar('$plr')) {
                        state.setVar('$plr.stats.life.pre', curLife)
                    }

                    if (curLife > 0) {
                        let d = 1 * mult
                        let r = curLife - d;
                        
                        state.setVar('$spellCastVar.spellTarget.stats.life.cur', r);
                        State.setVar('$spellCastVar.damageDone', d)
                    }
                }
            },
            heal: {
                latin: 'Vulnus',
                description: 'Renews the lifeforce and heals the surface wounds of living beings.',
                costMult: 1,
                unlocked: false,
                discipline: 'restoration',
                badCombo : function(){
                    if (state.getVar('$spellCastVar.spellTarget') == 'room' || state.getVar('$spellCastVar.spellTarget') == 'playerHome')  {
                        State.setVar('$spellCastVar.badCombo', 'Healing a room? I don\'t know how that would even work.')
                    }
                },
                onCast: function() {
                    let curLife = state.getVar('$spellCastVar.spellTarget.stats.life.cur');
                    let maxLife = state.getVar('$spellCastVar.spellTarget.stats.life.max');
                    let mult = state.getVar('$spellCastVar.spellEnhancement');
                    
                    if(state.getVar('$spellCastVar.spellTarget') == state.getVar('$plr')) {
                        state.setVar('$plr.stats.life.pre', curLife)
                    }
                    
                    if (curLife < maxLife) {
                        let d = 1 * mult
                        let r = curLife + d;

                        if (r >= maxLife) {
                            r = maxLife
                        };
                        state.setVar('$spellCastVar.spellTarget.stats.life.cur', r);
                        State.setVar('$spellCastVar.healDone', d)
                    }
                }
            },
            calm: {
                latin: 'Tranquillitas',
                description: 'Eases the mind, restoring a small amount of sanity.',
                costMult: 1.5,
                unlocked: false,
                discipline: 'restoration',
                badCombo: function(){
                    return false
                },
                onCast: function() {
                    return 'xxxxx'
                }
            },
            clean: {
                latin: 'Mundare',
                description: 'Break your back cleaning no more, let the dust collect itself and walk out the door.',
                costMult: 1.3,
                unlocked: false,
                timesCast: 0,
                discipline: 'transmutation',
                badCombo: function() {
                    if(state.getVar('$spellCastVar.spellTarget') == state.getVar('$plr')) {
                        state.setVar('$spellCastVar.badCombo', 'Why would I use a powerful surface scrubbing spell on myself?')
                    
                    } else if (state.getVar('$spellCastVar.spellTarget') == 'room' || state.getVar('$spellCastVar.spellTarget') == 'playerHome')  {
                        State.setVar('$spellCastVar.badCombo', false)
                    }
                    else {
                        state.setVar('$spellCastVar.badCombo', 'Why would I try to clean this? Seems pointless.')
                    }
                },
                onCast: function() {
                    let eLevel = state.getVar('$spellCastVar.spellEnhancement')
                    if (state.getVar('$spellCastVar.passageTag') == 'playerHome') {
                        let cln = state.getVar('$roomVars.Residence_Starr_PlayerRoom.clean')
                        let r = cln - (4 * eLevel)
                        state.setVar('$roomVars.Residence_Starr_PlayerRoom.clean', r)

                        let tc = State.getVar('$spellWords.effect.clean.timesCast')
                        tc = tc + 1
                        State.setVar('$spellWords.effect.clean.timesCast', tc)

                    } else if (state.getVar('$spellCastVar.passageTag') == 'room') {
                        let pass = state.getVar('$spellCastVar.passageTitle')
                        let adrs ='$roomVars.' + pass + '.clean'
                        let cln = state.getVar(adrs)
                        let r = cln - (4 * eLevel)
                        state.setVar(adrs, r)

                        let tc = State.getVar('$spellWords.effect.clean.timesCast')
                        tc = tc + 1
                        State.setVar('$spellWords.effect.clean.timesCast', tc)
                    }
                }
            },
            light: {
                latin: 'Lux',
                description: 'Adds a light to the target. If cast on a room that you call yours, the light is permanent. If not, the light dispells when you leave.',
                costMult: 1.5,
                unlocked: false,
                discipline: 'conjuration',
                badCombo: function() {
                    if(state.getVar('$spellCastVar.spellTarget') == state.getVar('$plr')) {
                        state.setVar('$spellCastVar.badCombo', 'I\'m not sure what purpose would be served by making myself light up right now...')

                    } else if (State.getVar('$spellCastVar.spellTarget') == 'room' || State.getVar('$spellCastVar.spellTarget') == 'playerHome') {
                        State.setVar('$spellCastVar.badCombo', false)
                    } else {
                        State.setVar('$spellCastVar.badCombo', 'Making my target glow seems rather...unhelpful.')
                    }
                },
                onCast: function() {

                    let eLevel = state.getVar('$spellCastVar.spellEnhancement')
                    if (state.getVar('$spellCastVar.passageTag') == 'room') {
                        return 'xxxxx'

                    } else if (state.getVar('$spellCastVar.passageTag') == 'playerHome') {
                        if (eLevel == 1) {
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.none', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.trash', true)
                        } else if (eLevel == 2) {
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.none', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.trash', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.common', true)
                        } else if (eLevel == 3) {
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.none', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.trash', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.common', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.uncommon', true)
                        } else if (eLevel == 4) {
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.none', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.trash', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.common', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.uncommon', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.rare', true)
                        } else if (eLevel == 5) {
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.none', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.trash', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.common', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.uncommon', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.rare', false)
                            state.setVar('$roomVars.Residence_Starr_PlayerRoom.lights.legendary', true)
                        }
                    }
                }
            }
        },
        enhancement: {
            none: {
                latin: 'Nullus',
                description: 'Choose to not increase the power of your spell.',
                costMult: 1,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 1);
                }
            },
            enhance1: {
                latin: 'Augere',
                description: 'Add a little more of your energy into the spell.',
                costMult: 2,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 2);
                }
            },
            enhance2: {
                latin: 'Augmento',
                description: 'Add a decent amount of energy into the spell.',
                costMult: 5,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 3)
                }
            },
            enhance3: {
                latin: 'Amplius',
                description: 'Pour your energy into the spell!',
                costMult: 15,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 4)
                }
            },
            enhance4: {
                latin: 'Vastus',
                description: 'Give the spell almost everything you have!!',
                costMult: 30,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 5)
                }
            },
            enhance5: {
                latin: 'Immanis',
                description: 'You will not be contained!!!',
                costMult: 60,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 7)
                }
            }
        }
    }>>