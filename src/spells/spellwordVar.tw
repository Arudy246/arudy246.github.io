:: Spell-Variables [init]
    <<set $spellCastVar = {
        spellTarget: '',
        spellDuration: '',
        spellEffect: '',
        spellEnhancement: '',
        spellCost: 0,
        spellDiscipline: '',
        passageTag: '',
        badCombo: false
    }>>

    <<set $spellWords = {
        target: {
            self: {
                latin: 'Ego',
                description: 'Sets the caster as the focus of the spell.',
                unlocked: false,
                costMult: 0.5,
                onCast: function() {
                    let x = state.getVar('$plr');
                    state.setVar('$spellCastVar.spellTarget', x);
                }
            },
            other: {
                latin: 'Alius',
                description: 'Sets a nearby person or creature as the focus of the spell.',
                unlocked: false,
                costMult: 1,
                onCast: function() {
                    let x = state.getVar('$npcs.janessa');
                    state.setVar('$spellCastVar.spellTarget', x);
                }
            },
            room: {
                latin: 'Praesto',
                description: 'Choose the room you are in as the focus of the spell.',
                unlocked: false,
                costMult: 1.5,
                onCast: function() {
                    state.setVar('$spellCastVar.spellTarget', 'room')
                }
            },
            outdoors: {
                latin: 'Circa',
                description: 'Selects a large outdoor area (i.e. a courtyard, tree grove, or park) as the focus of the spell.',
                unlocked: false,
                costMult: 1.5,
                onCast: function() {
                    return 'xxxxx'
                }
            },
            item: {
                latin: 'Item',
                description: 'Picks an item as the focus of the spell.',
                unlocked: false,
                costMult: 1,
                onCast: function() {
                    return 'xxxxx'
                }
            }
        },
        duration: {
            immediate: {
                latin: 'Nunc',
                description: 'The spell effect is applied immediately.',
                costMult: 1,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 0);
                }
            },
            minute: {
                latin: 'Mox',
                description: 'The spell applies the affect now and for a few minutes.',
                costMult: 5,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 10);
                }
            },
            hour: {
                latin: 'Postea',
                description: 'The spell applies the effect now and for about an hour.',
                costMult: 10,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 60);
                }
            },
            day: {
                latin: 'Hodie',
                description: 'The spell applies the effect for about a day.',
                costMult: 20,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 1440);
                }
            },
            week: {
                latin: 'Septimana',
                description: 'The spell applies the effect for around one week',
                costMult: 40,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 10080);
                }
            },
            month: {
                latin: 'Mensis',
                description: 'The spell applies the effect for a whole month.',
                costMult: 60,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellDuration', 40320);
                }
            }
        },
        effect: {
            damage: {
                latin: 'Damnum',
                description: 'Uses the destructive aspect of elemental magic to cause physical injuries.',
                costMult: 1,
                unlocked: false,
                discipline: 'elemental',
                badCombo : function(){
                    return false
                },
                onCast: function() {
                    let curLife = state.getVar('$spellCastVar.spellTarget.stats.life.cur');
                    let maxLife = state.getVar('$spellCastVar.spellTarget.stats.life.max');
                    let mult = state.getVar('$spellCastVar.spellEnhancement');

                    if (curLife > 0) {
                        let r = curLife - (1 * mult);
                        state.setVar('$spellCastVar.spellTarget.stats.life.cur', r);
                    }
                }
            },
            heal: {
                latin: 'Vulnus',
                description: 'Renews the lifeforce and heals the surface wounds of living beings.',
                costMult: 1,
                unlocked: false,
                discipline: 'restoration',
                badCombo : function(){
                    return false
                },
                onCast: function() {
                    let curLife = state.getVar('$spellCastVar.spellTarget.stats.life.cur');
                    let maxLife = state.getVar('$spellCastVar.spellTarget.stats.life.max');
                    let mult = state.getVar('$spellCastVar.spellEnhancement');
                    
                    if (curLife < maxLife) {
                        let r = curLife + (1 * mult);

                        if (r >= maxLife) {
                            r = maxLife
                        };
                        state.setVar('$spellCastVar.spellTarget.stats.life.cur', r);
                    }
                }
            },
            calm: {
                latin: 'Tranquillitas',
                description: 'Eases the mind, restoring a small amount of sanity.',
                costMult: 1.5,
                unlocked: false,
                discipline: 'restoration',
                badCombo : function(){
                    return false
                },
                onCast: function() {
                    return 'xxxxx'
                }
            },
            light: {
                latin: 'Lux',
                description: 'Adds a light to the target. If cast on a room that you call yours, the light is permanent. If not, the light dispells when you leave.',
                costMult: 1.5,
                unlocked: false,
                discipline: 'conjuration',
                badCombo: function() {
                    if(state.getVar('$spellCastVar.spellTarget') == state.getVar('$plr')) {
                        state.setVar('$spellCastVar.badCombo', 'I\'m not sure what purpose would be served by making myself light up right now...')

                    } else {
                        state.setVar('$spellCastVar.badCombo', false)
                    }
                },
                onCast: function() {

                    let eLevel = state.getVar('$spellCastVar.spellEnhancement')
                    if (state.getVar('$spellCastVar.passageTag') == 'room') {
                        return 'xxxxx'

                    } else if (state.getVar('$spellCastVar.passageTag') == 'playerHome') {
                        if (eLevel == 1) {
                            state.setVar('$plrRoom.lights.none', false)
                            state.setVar('$plrRoom.lights.trash', true)
                        } else if (eLevel == 2) {
                            state.setVar('$plrRoom.lights.none', false)
                            state.setVar('$plrRoom.lights.trash', false)
                            state.setVar('$plrRoom.lights.common', true)
                        } else if (eLevel == 3) {
                            state.setVar('$plrRoom.lights.none', false)
                            state.setVar('$plrRoom.lights.trash', false)
                            state.setVar('$plrRoom.lights.common', false)
                            state.setVar('$plrRoom.lights.uncommon', true)
                        } else if (eLevel == 4) {
                            state.setVar('$plrRoom.lights.none', false)
                            state.setVar('$plrRoom.lights.trash', false)
                            state.setVar('$plrRoom.lights.common', false)
                            state.setVar('$plrRoom.lights.uncommon', false)
                            state.setVar('$plrRoom.lights.rare', true)
                        } else if (eLevel == 5) {
                            state.setVar('$plrRoom.lights.none', false)
                            state.setVar('$plrRoom.lights.trash', false)
                            state.setVar('$plrRoom.lights.common', false)
                            state.setVar('$plrRoom.lights.uncommon', false)
                            state.setVar('$plrRoom.lights.rare', false)
                            state.setVar('$plrRoom.lights.legendary', true)
                        }
                    }
                }
            }
        },
        enhancement: {
            none: {
                latin: 'Nullus',
                description: 'Choose to not increase the power of your spell.',
                costMult: 1,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 1);
                }
            },
            enhance1: {
                latin: 'Augere',
                description: 'Add a little more of your energy into the spell.',
                costMult: 2,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 2);
                }
            },
            enhance2: {
                latin: 'Augmento',
                description: 'Add a decent amount of energy into the spell.',
                costMult: 5,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 3)
                }
            },
            enhance3: {
                latin: 'Amplius',
                description: 'Pour your energy into the spell!',
                costMult: 15,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 4)
                }
            },
            enhance4: {
                latin: 'Vastus',
                description: 'Give the spell almost everything you have!!',
                costMult: 30,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 5)
                }
            },
            enhance5: {
                latin: 'Immanis',
                description: 'You will not be contained!!!',
                costMult: 60,
                unlocked: false,
                onCast: function() {
                    state.setVar('$spellCastVar.spellEnhancement', 7)
                }
            }
        }
    }>>