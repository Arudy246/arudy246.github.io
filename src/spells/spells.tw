:: Spell-List [init]

    <<set $spellEffects = {
        lightRoom: "<<set $plrRoom.lights.none = false>> <<set $plrRoom.light.trash = true>>"
    }>>

    <<set $spellDetails = {
        abjuration: {

        },
        alchemy: {

        },
        illusion: {
            floatingflame: {
                name: "Floating Flame",
                description: "Creates a warm, but kind of dim floating flame. Good for light up a room.",
                unlocked: false,
                staminaCost: 3,
                diffLevel: 1,
                effect: $spellEffects.lightRoom,
                onCast: "<<set $plrDisciplines.illusion.level += 1>>",
                spellLevel: "basic"
            }
        }
    }>>