        <div id="hygieneBar" class="hzbarbkg"><div id="hygieneBar" class="hzbar"></div></div><<run Hygiene($plrStats.hygiene.cur, $plrStats.hygiene.max, "hygieneBar", true)>>
        <span id='ui-hygiene' class='darkgreen'>Hygiene: </span>$plrStats.hygiene.cur / $plrStats.hygiene.max</span>
    <</if>> */
<</nobr>>\
\
<<nobr>>
    <<if $plrStats.focus.max != 0>>
        <div id="focusBarbkg" class="hzbarbkg"><div id="focusBar" class="hzbar"></div></div>
        <span class="greenyellow">Focus: </span><span id='ui-focus'></span><<run focus($plrStats.focus.cur, $plrStats.focus.max, "focusBar", true)>>
        <<run FocusStat($plrStats.focus.cur, $plrStats.focus.max, "focusBar", true)>>
        <hr>
    <</if>>
<</nobr>>
<<nobr>>
    <<if $plrStats.sanity.max != 0>>
        <div id="sanityBarbkg" class="hzbarbkg"><div id="sanityBar" class="hzbar"></div></div><<run Sanity($plrStats.sanity.cur, $plrStats.sanity.max, "sanityBar", true)>>
        <span class="purple">Sanity: </span><span id='ui-sanity'></span>
        <<run Sanity($plrStats.sanity.cur, $plrStats.sanity.max, "sanityBar", true)>>
        <hr>
    <</if>>
<</nobr>>\