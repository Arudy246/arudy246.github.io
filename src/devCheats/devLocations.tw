:: DevWand

    <<button [[Quick Start | WakingUp14]]>>
        <<set $plrName.fName = "Azure">>
        <<set $plrName.lName = "Paine">>
        <<set $plrName.prefix = "Mr.">>
        <<set $plrBody.static.sex = "male">>
        <<set $plrBody.static.hairColor = "blue">>
        <<set $plrBody.static.hairStyle = "mohawk">>
        <<set $plrBody.static.eyeColor = "amber">>
        <<set $plrBody.static.faceShape = "square">>
        <<set $plrBody.static.height = "tall">>
        <<set $plrBody.dynamic.hairLength = 1>>
        <<set $plrBody.dynamic.weight = 35>>
        <<calcAttractiveness>>

        <<set $plrStats.stamina.max = 10>>
        <<set $plrStats.stamina.cur = 10>>
        <<set $plrStats.life.max = 10>>
        <<set $plrStats.life.cur = 10>>
        <<set $plrStats.sanity.max = 3>>
        <<set $plrStats.sanity.cur = 3>>
        <<set $plrStats.focus.max = 5>>
        <<set $plrStats.focus.cur = 5>>
        <<set $plrImg = "img/characters/thumb_male_bro_white.jpg">>

        <<run Dialog.close()>>
    <</button>>

    <<link "TestingGrounds">>
        <<run
            Dialog.setup("TestingGrounds");
            Dialog.wiki(Story.get("TestingGrounds").processText());
            Dialog.open();
        >>
    <</link>>

